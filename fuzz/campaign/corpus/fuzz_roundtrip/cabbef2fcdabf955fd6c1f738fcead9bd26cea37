/* Fast integer inverse (fi_inverse) against the reference (kg_int_inv). On every program, well formed or damaged, the
 * two must return the same code and, when it is 0, the same bytes. Covered: each fast path (24 functions: element
 * width 2/4/8 x residual width 1/2/4/8 x sign; in each, order 0/1/2 with a common factor of 1 or larger: 144 cases),
 * each case left to the reference (width 1, interleaved residuals), short counts, header and tail bytes, values that
 * wrap, the output limit, damaged parameters and stream lengths, and integer arrays through the encoder, kg_decode
 * and the public interface.
 * Run under AddressSanitizer by `make check-fastint`. */
#include "../src/kolmo.c"
#include <stdio.h>

static uint64_t rs = 0x9E3779B97F4A7C15ull;
static uint64_t rnd64(void) { rs ^= rs << 13; rs ^= rs >> 7; rs ^= rs << 17; return rs * 0x2545F4914F6CDD1Dull; }
static uint32_t rnd(void) { return (uint32_t)(rnd64() >> 32); }

static long cases, accepted, fails;
static int seen[3][4][2][3][2];     /* [width 2/4/8][residual width 1/2/4/8][sign][order][factor > 1]: accepted, with residuals */

/* Both inverses on one program. exact > 0: each gets a buffer of exactly the size it reserves (exact + 16), with the
 * 16 spare bytes marked: neither writes past its output today, and a store wider than the element would show here.
 * Returns the reference's code. */
static int both(const uint8_t *par, size_t plen, const kbuf *res, const kbuf *rest, size_t maxs, size_t exact, const char *what) {
    kbuf a = {0}, b = {0};
    if (exact) {
        a.p = malloc(exact + 16); b.p = malloc(exact + 16); a.cap = b.cap = exact + 16;
        if (!a.p || !b.p) { printf("out of memory\n"); exit(2); }
        memset(a.p + exact, 0xC5, 16); memset(b.p + exact, 0xC5, 16);
    }
    int ra = kg_int_inv(par, plen, res, rest, maxs, &a), rb = fi_inverse(par, plen, res, rest, maxs, &b);
    cases++;
    if (ra != rb || (!ra && (a.n != b.n || memcmp(a.p, b.p, a.n)))) {
        if (fails++ < 20) printf("MISMATCH (%s): reference returns %d with %zu bytes, fast returns %d with %zu bytes; width %d, flags %d, residual width %d\n",
                                 what, ra, a.n, rb, b.n, plen > 0 ? par[0] : -1, plen > 1 ? par[1] : -1, plen > 2 ? par[2] : -1);
    }
    if (exact && !ra && !rb) {
        if (a.n != exact || b.n != exact) { if (fails++ < 20) printf("WRONG LENGTH (%s): %zu and %zu bytes, expected %zu\n", what, a.n, b.n, exact); }
        else for (int i = 0; i < 16; i++) if (a.p[exact + i] != 0xC5 || b.p[exact + i] != 0xC5) {
            if (fails++ < 20) printf("WROTE PAST THE OUTPUT (%s): width %d, flags %d, residual width %d\n", what, par[0], par[1], par[2]);
            break;
        }
    }
    accepted += !ra;
    free(a.p); free(b.p);
    return ra;
}

