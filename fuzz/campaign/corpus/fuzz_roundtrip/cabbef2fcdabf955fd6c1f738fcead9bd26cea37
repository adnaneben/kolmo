            size_t el = rnd() % 8 ? (size_t)tn : rnd() % tn;
            tbl2) % (unsigned)w, n = h + cnt * (size_t)w + tail;
        uint8_t *in = malloc(n + 8), *z = malloc(n + 4096), *out = malloc(n + 8);
        if (!in || !z || !out) { printf("out of memory\n"); return 2; }
        for (size_t i = 0; i < n; i++) in[i] = (uint8_t)rnd();
        uint64_t v = rnd() % 1000, step = 0;
        for (size_t q = 0; q < cnt; q++) {
            uint32_t k = rnd();
            switch (kind) {
            case 0: v += (uint64_t)(int64_t)((int)(k % 201) - 100); break;              /* a walk: first differences */
            case 1: step += (uint64_t)(int64_t)((int)(k % 7) - 3); v += step; break;      /* a smooth curve: second differences */
            case 2: v = (uint64_t)(k % 5000) * 1000; break;                               /* multiples of 1000: a common factor */
            case 3: v = k % 200; break;                                                   /* small counts: one-byte residuals */
            case 4: v = rnd64(); break;                                                   /* noise: residuals as wide as the element */
            case 5: break;                                                                /* one value repeated */
            case 6: v = (uint64_t)(int64_t)((int)(k % 2001) - 1000); break;               /* around zero: signed */
            default: v = (w == 8 ? UINT64_MAX : ((uint64_t)1 << (8 * w)) - 1) - k % 3000; break;   /* just under the unsigned maximum */
            }
            for (int b = 0; b < w; b++) in[h + q * (size_t)w + (size_t)b] = (uint8_t)(v >> (8 * b));
        }
        size_t zn = kg_encode_num(&cx, C_ZSTD, 3, in, n, w, h, z, n + 4096);
        if (zn) {
            arrays++; coded[kind]++; memset(out, 0xA5, n);
            if (kg_decode(&cx, z, zn, out, n) || memcmp(in, out, n)) { if (fails++ < 20) printf("ROUND TRIP FAIL: array %d, width %d, kind %d, %zu bytes\n", it, w, kind, n); }
            if (!kg_decode(&cx, z, zn, out, n - 1) || !kg_decode(&cx, z, zn - 1, out, n)) { if (fails++ < 20) printf("LENGTH NOT CHECKED: array %d\n", it); }
        }
        if (it % 7 == 0) {
            kolmo_params kp = {KOLMO_FAST, 0, 1, 0, 1}; size_t cap = kolmo_bound(n, &kp); uint8_t *f = malloc(cap);
            if (!f) { printf("out of memory\n"); return 2; }
            int64_t fn = kolmo_compress(in, n, f, cap, &kp);
            memset(out, 0x5A, n);
            if (fn <= 0 || kolmo_decompress(f, (size_t)fn, out, n, 1) != (int64_t)n || memcmp(in, out, n)) { if (fails++ < 20) printf("PUBLIC ROUND TRIP FAIL: array %d, width %d, kind %d\n", it, w, kind); }
