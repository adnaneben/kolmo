    for (int a = 0; a < 3; a++) for (int b = 0; b < 4; b++) for (int c = 0; c < 2; c++) for (int d = 0; d < 3; d++) for (int e = 0; e < 2; e++) loops += seen[a][b][c][d][e] > 0;
