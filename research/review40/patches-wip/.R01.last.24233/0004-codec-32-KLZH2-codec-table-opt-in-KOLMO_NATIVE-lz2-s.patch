+++ b/benchmark/review40/klzh2/gen_pre.c
@@ -0,0 +1,35 @@
+/* gen_pre: fits KLZH2's predefined tANS tables (src/algo/klz.c, KZ2_PRE_*) to small blocks.
+ * usage: gen_pre FILE...   Every file is cut into blocks of 2, 4, 8, 16 and 32 KiB, each coded at levels 1 and 3; the
+ * symbols of the five code streams (tokens, literal-length codes, match-length codes after a repeat offset and after
+ * a new one, offset nibbles) are counted, each block size weighing the same, and the counts are scaled to 2^9 with the
+ * coder's own normalisation (a symbol that was never seen gets no state). Prints the C arrays.
+ * build: cc -O2 -Isrc -Isrc/algo benchmark/review40/klzh2/gen_pre.c src/algo/khuf.c -o build/gen_pre */
+#include <stdio.h>
+#include <stdint.h>
+#include <stddef.h>
+static double CNT[6][256]; static double W = 1;
+static void trace(int q, const uint8_t *p, size_t n) { for (size_t i = 0; i < n; i++) CNT[q][p[i]] += W; }
+#define KZ2_TRACE(Q, P, N) trace(Q, P, N)
+#include "../../../src/algo/klz.c"
+int main(int argc, char **argv) {
+    static const size_t BS[5] = {2048, 4096, 8192, 16384, 32768};
+    for (int a = 1; a < argc; a++) {
+        FILE *f = fopen(argv[a], "rb"); if (!f) { perror(argv[a]); return 1; }
+        fseek(f, 0, SEEK_END); size_t n = (size_t)ftell(f); rewind(f);
+        uint8_t *in = malloc(n + 1), *out = malloc(kolmo_klzh_bound(32768)); if (fread(in, 1, n, f) != n) return 1; fclose(f);
+        for (int b = 0; b < 5; b++) for (int lv = 1; lv <= 3; lv += 2)
+            for (size_t i = 0; i + BS[b] <= n; i += BS[b]) kolmo_klzh2_compress(in + i, BS[b], out, kolmo_klzh_bound(32768), lv);
+        free(in); free(out);
+    }
+    static const char *NM[6] = {"", "TOK", "LLX", "MLR", "MLN", "NIB"}; static const int NS[6] = {0, KZ2_NTOK, 72, KZ2_NML, KZ2_NML, 16};
+    for (int q = 1; q < 6; q++) {
+        uint32_t c[256]; uint16_t fq[256]; double t = 0; uint32_t ti = 0;
+        for (int s = 0; s < NS[q]; s++) t += CNT[q][s];
+        for (int s = 0; s < NS[q]; s++) { c[s] = (uint32_t)(CNT[q][s] * 1e6 / (t > 0 ? t : 1)); if (CNT[q][s] > 0 && !c[s]) c[s] = 1; ti += c[s]; }
+        kza_normalize(c, NS[q], ti, 9, fq);
+        printf("static const uint16_t KZ2_PRE_%s[%d] = {", NM[q], NS[q]);
+        for (int s = 0; s < NS[q]; s++) printf("%s%u", s ? (s % 32 ? "," : ",\n    ") : "", fq[s]);
+        printf("};\n");
+    }
+    return 0;
+}
