+/* m symbols (histogram cnt over nsym <= KZ2_NTOK symbols, at least two present) as one tANS payload: the table
+ * header, the two start states (L bits each), the bits. pr: m words of scratch. Returns the size, or 0 when it does
+ * not fit in cap. */
+static size_t kza_encode(const uint8_t *s, size_t m, const uint32_t *cnt, int nsym, int lmax, uint8_t *o, size_t cap, uint16_t *pr) {
+    int mp = 0, last = 0; for (int q = 0; q < nsym; q++) if (cnt[q]) { mp++; last = q; }
+    int L = kz_hb((uint32_t)m); const int lo = kz_hb((uint32_t)(mp - 1)) + 2;
+    if (L < lo) L = lo;
+    if (L < 5) L = 5;
+    if (L > lmax) L = lmax;
+    const uint32_t M = 1u << L;
+    uint16_t f[KZ2_NTOK], cum[KZ2_NTOK + 1], k[KZ2_NTOK], thr[KZ2_NTOK], nxt[1 << KZA_MAXLOG]; uint8_t mb[KZ2_NTOK], slot[1 << KZA_MAXLOG];
+    kza_normalize(cnt, nsym, (uint32_t)m, L, f);
+    cum[0] = 0;
+    for (int q = 0; q < nsym; q++) {
+        cum[q + 1] = (uint16_t)(cum[q] + f[q]); k[q] = cum[q]; mb[q] = 0; thr[q] = 0;
+        if (f[q]) { mb[q] = (uint8_t)(L - kz_hb(f[q])); thr[q] = (uint16_t)(f[q] << mb[q]); }
+    }
+    kza_spread(f, nsym, L, slot);
+    for (uint32_t x = 0; x < M; x++) nxt[k[slot[x]]++] = (uint16_t)(M + x);
+    uint32_t X[2] = {M, M};
+    for (size_t i = m; i-- > 0;) {   /* from state x, symbol q: nb low bits out, v = x >> nb in [f, 2f), next state the (v - f)-th of q */
+        const unsigned q = s[i]; const uint32_t x = X[i & 1]; const int nb = mb[q] - (x < thr[q]);
+        pr[i] = (uint16_t)((x & ((1u << nb) - 1)) | (uint32_t)nb << 12);
+        X[i & 1] = nxt[cum[q] + (x >> nb) - f[q]];
+    }
+    kz_bw w = {0, 0, o, o + cap};
+    if (kza_put_counts(&w, f, last, L) || kz_bput(&w, X[0] - M, L) || kz_bput(&w, X[1] - M, L)) return 0;
+    for (size_t i = 0; i < m; i++) if (kz_bput(&w, pr[i] & 0xFFFu, pr[i] >> 12)) return 0;
+    if (w.p + 8 > w.e) return 0;
