+    for (; i + 4 <= m; i += 4) { kz_refill(&r); KZA_DEC(x0, out[i]); KZA_DEC(x1, out[i + 1]); KZA_DEC(x0, out[i + 2]); KZA_DEC(x1, out[i + 3]); }
+    for (; i < m; i++) { kz_refill(&r); if (i & 1) KZA_DEC(x1, out[i]); else KZA_DEC(x0, out[i]); }
+#undef KZA_DEC
+    const int64_t used = (int64_t)(r.p - in) * 8 - r.c;   /* bits consumed: all of the payload but the padding of its last byte */
+    return !x0 && !x1 && used <= (int64_t)z * 8 && used > ((int64_t)z - 1) * 8 ? 0 : -1;
+}
