-        else { for (int s = 0; s < nsym; s++) if (f[s] > 1) { uint64_t g = (uint64_t)c[s] * (kz2_lg(f[s]) - kz2_lg(f[s] - 1u)); if (b < 0 || g < bv) { b = s; bv = g; } } f[b]--; sum--; }
+    if (sum == M) return;
+    const int up = sum < M; uint64_t h[256]; int n = 0;
+    for (int s = 0; s < nsym; s++) if (f[s] > (up ? 0 : 1)) h[n++] = kza_nkey(c, f, (unsigned)s, up);
+    for (int i = n / 2; i-- > 0;) kza_sift(h, n, i);
+    for (; sum != M; sum += up ? 1 : -1) {   /* M >= the number of present symbols, so a candidate is left while sum > M */
+        const unsigned b = (unsigned)(h[0] & 255);
+        f[b] = (uint16_t)(f[b] + (up ? 1 : -1));
+        if (up || f[b] > 1) h[0] = kza_nkey(c, f, b, up); else h[0] = h[--n];
+        kza_sift(h, n, 0);
     }
 }
