 size_t kolmo_klzh_bound(size_t n) { return n + n / 64 + 1024; }
+/* the parse of a KLZH level (1-9), shared by codecs 29 and 32 */
+static size_t kzh_parse(const uint8_t *in, size_t n, int level, kz_seq *S, size_t *anchor, int *err) {
+    const kz_par *LV = &KLZH_LV[level];
