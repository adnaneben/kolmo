 size_t kolmo_klzh_compress(const uint8_t *in, size_t n, uint8_t *out, size_t cap, int level) {
     if (n < 16 || n >= 0xFFFFFFF0u || cap < 64) return 0;
     if (level < 1) level = 1;
     if (level > 9) level = 9;
     kz_seq *S = malloc((n / 4 + 2) * sizeof *S); size_t anchor; int err;
     if (!S) return 0;
