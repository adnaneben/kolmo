index 00000000..0e356a22
--- /dev/null
+++ b/src/algo/krans.h
@@ -0,0 +1,77 @@
+/* Kolmo context rANS (krans): Kolmo's own static rANS coder with static context modelling, the entropy coder of
+   graph leaf codec 33. Copyright 2026 Adnane Aqartit and contributors, Apache-2.0.
+
+   The method is Jarek Duda's asymmetric numeral systems (range variant, "Asymmetric numeral systems: entropy coding
+   combining speed of Huffman coding with compression rate of arithmetic coding", arXiv:1311.2540); interleaving
+   several states in one word stream follows Fabian Giesen, "Interleaved entropy coders", arXiv:1402.3392; contexts
+   mapped onto a smaller set of shared tables is the idea of the context maps of Brotli and JPEG XL. All code here
+   was written for Kolmo.
+
+   CODER. 32-bit states in [2^16, 2^32), totals 2^12, renormalisation by 16-bit little-endian words (at most one per
+   symbol in either direction). A chunk of m bytes is cut into S = 1, 2, 4, 8, 16 or 32 contiguous segments of
+   floor(m / S) bytes (the last one takes the m mod S bytes left over); segment k is coded by state k, and the
+   decoder takes byte i of every segment in turn (i = 0, 1, ...; segment 0 first), then the left-over bytes with
+   state S - 1. A byte's context only looks at earlier bytes of its own segment, so the S chains are independent.
+   The encoder starts every state at 2^16 and codes backwards; the decoder must end with every state at 2^16 and the
+   word stream used up exactly, which is the integrity check of a chunk.
+
+   CONTEXTS. Byte j of a chunk (position i in its segment) is coded under
+       context = (QE[e] * NB + QB[prev]) * P + phase
+     phase = j mod P, P = 1..8 (channel of an interleaved image, byte of a word);
+     e     = sum of MAG[byte at i - lag] over the 0..4 lags of the header (lags that reach before the segment start
+             count 0), quantised by QE into NE bins: eq 0: none (NE 1, no lags); eq 1: 17 bins with edges
+             1 2 4 6 8 11 14 18 23 29 37 47 60 80 110 160; eq 2: 9 bins with edges 1 3 6 11 18 29 47 80;
+     prev  = the byte at i - 1 (0 at the segment start), quantised by QB into NB bins: bq 0: none (NB 1); bq 1: the
+             byte itself (NB 256, order 1); bq 2: the bin k of MAG[prev] with edges 1 3 6 12 25 (NB 6); bq 3: the
+             same bin with the sign: 0 for k = 0, else 2k - 1 for a positive and 2k for a negative byte (NB 11).
+             With the header's pf bit the term is 0 in phase 0 (the previous byte belongs to another pixel).
+     MAG   = mk 0: (b + 1) >> 1, negative when b is odd (zigzag residuals); mk 1: min(b, 256 - b), negative when
+             b >= 128 (two's complement); mk 2: b, never negative.
+   A bin index is the number of edges <= the value. N = NE * NB * P <= 4096 contexts; a context map sends each to one
+   of T <= 255 frequency tables (the encoder merges contexts whose tables do not pay for themselves).
+
+   LEAF (codec 33) = chunks until the raw length is reached; every chunk is independent. Chunk:
+     kind u8: 0 stored: m uv, m bytes | 1 fill: m uv, the byte | 2 coded:
+       m uv (1 .. 2^24)
+       b0: bits 0-2 log2 S (0..5), bits 3-5 P - 1, bits 6-7 mantissa bits MB of the tables (0..3 -> 3, 4, 6, 12)
+       b1: bits 0-1 eq, bits 2-3 bq, bits 4-5 mk, bit 6 pf (only with bq != 0 and P > 1), bit 7 zero
+       if eq != 0: lag count u8 (1..4), each lag uv (1 .. 2^24)
+       T - 1 u8 (T <= N, T <= 1 + m / 16)
+       a bit stream, least significant bit first, zero-padded to a whole byte:
+         context map (T > 1 only): per context one bit, 1 = the table of the context before it (table 0 before
+           the first), 0 = followed by the table index in ceil(log2 T) bits;
+         T tables: lo 8 bits, hi 8 bits (first and last present symbol), then for each symbol lo..hi its class by a
+           prefix code against the previous class pc (0 at lo): 0 same, 10 pc - 1, 110 pc + 1, 1110 pc - 2,
+           11110 pc + 2, 11111 + 4 bits: the class itself (0..12), or 14 for the one symbol of the table that takes
+           what the others leave of 2^12 (pc is not changed by it). Class 0 is an absent symbol; class e >= 1 is a
+           frequency in [2^(e-1), 2^e) and is followed by min(e - 1, MB) bits: the bits below its top bit, the rest 0.
+       z uv, then z bytes: S states (4 bytes each, little-endian, segment 0 first), then the 16-bit words.
+   uv is LEB128. A decoder refuses anything else (reserved values, a table whose coded frequencies leave nothing for
+   the class-14 symbol, lo or hi absent, a context map entry >= T, non-zero padding, a short or long word stream). */
+#ifndef KOLMO_ALGO_KRANS_H
+#define KOLMO_ALGO_KRANS_H
+#include <stddef.h>
+#include <stdint.h>
+
+#define KRANS_CHUNK_MAX (1u << 24)
+#define KRANS_NCTX_MAX 4096
+
+/* Encoder choices. Zero-initialise for the defaults. */
+typedef struct {
+    uint32_t stride;     /* row length in bytes of an image-like leaf (0: unknown): enables the neighbour contexts */
+    uint8_t step;        /* bytes per pixel (channel step, 1..8) when stride is set; 0 = 1 */
+    uint8_t effort;      /* 0/1: order 0, then the image contexts (stride set) or order 1; 2: more image context sets tried */
+    uint32_t chunk;      /* chunk size in bytes (0: chosen from the leaf) */
+    /* tests and experiments: force one context set on every coded chunk (force = 1) */
+    uint8_t force, ls, P, mb, eq, bq, mk, pf, nlag;
+    uint32_t lag[4];
+    uint8_t max_tables;  /* 0 = 64 */
+} kolmo_krans_params;
+
+size_t kolmo_krans_bound(size_t n);
+/* Returns the coded size, or 0 when cap is too small (cap >= kolmo_krans_bound(n) always suffices) or memory ran out. */
+size_t kolmo_krans_compress(const uint8_t *in, size_t n, uint8_t *out, size_t cap, const kolmo_krans_params *p);
+/* Decodes exactly n bytes from in[0..cn); 0 on success, -1 when the payload is not a valid leaf. Every read and
+   write is bounds-checked. Working memory: at most 255 tables of 5120 bytes, allocated as the chunks ask. */
+int kolmo_krans_decompress(const uint8_t *in, size_t cn, uint8_t *out, size_t n);
+#endif
diff --git a/tests/test_krans.c b/tests/test_krans.c
new file mode 100644
index 00000000..75711e17
--- /dev/null
+++ b/tests/test_krans.c
@@ -0,0 +1,166 @@
+/* Context rANS (src/algo/krans.c, graph leaf codec 33): round trips for every context set of the format on edge-case
+ * and generated inputs (with and without image geometry, every state count, every table precision), decoders on
+ * truncated and corrupted payloads and on hand-made invalid headers (they must fail cleanly, never read or write out
+ * of bounds: run under ASan/UBSan by make check-krans), a tight output buffer, and one pinned stream (the format is
+ * a decision: a stream written today must keep decoding to the same bytes).
+ * usage: test-krans [ITERATIONS]   (make check-krans) */
+#include "algo/krans.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static uint64_t rs = 0x9E3779B97F4A7C15ull;
+static uint32_t rnd(void) { rs ^= rs << 13; rs ^= rs >> 7; rs ^= rs << 17; return (uint32_t)(rs >> 16); }
+static int fails; static unsigned long ncase, ncoded;
+#define CHECK(c, ...) do { if (!(c)) { fails++; fprintf(stderr, "FAIL %s:%d: ", __FILE__, __LINE__); fprintf(stderr, __VA_ARGS__); fprintf(stderr, "\n"); } } while (0)
+
+/* inputs: 0 random, 1 zeros, 2 small alphabet, 3 text-like words, 4 periodic with noise, 5 two bytes, 6 long runs,
+ * 7 zigzagged residuals of a smooth image with noise (rows of W bytes, C channels), 8 skewed (geometric) bytes */
+static void gen(uint8_t *p, size_t n, int kind, size_t W, unsigned C) {
+    static const char *w[] = {"the ", "kolmo ", "compress ", "of ", "and ", "block ", "x", "\n", "1234 ", "data "};
+    size_t i = 0;
+    switch (kind) {
+        case 0: for (; i < n; i++) p[i] = (uint8_t)rnd(); break;
+        case 1: memset(p, 0, n); break;
+        case 2: for (; i < n; i++) p[i] = (uint8_t)("ACGT"[rnd() & 3]); break;
+        case 3: while (i < n) { const char *s = w[rnd() % 10]; while (*s && i < n) p[i++] = (uint8_t)*s++; } break;
+        case 4: for (; i < n; i++) p[i] = (uint8_t)((i % 37) * 7 + ((rnd() & 63) == 0 ? rnd() : 0)); break;
+        case 5: for (; i < n; i++) p[i] = (uint8_t)(rnd() % 50 == 0 ? 'b' : 'a'); break;
+        case 6: while (i < n) { size_t r = 1 + rnd() % 3000; uint8_t c = (uint8_t)rnd(); while (r-- && i < n) p[i++] = c; } break;
+        case 7:
+            for (; i < n; i++) {                          /* busy and quiet regions: the neighbours predict the magnitude */
+                const size_t y = i / (W ? W : 1), x = (i % (W ? W : 1)) / C; const unsigned busy = ((x / 24 + y / 16) & 3) * 9 + 1;
+                const int v = (int)(rnd() % (2 * busy + 1)) - (int)busy;
+                p[i] = (uint8_t)(v < 0 ? -2 * v - 1 : 2 * v);
+            }
+            break;
+        default: for (; i < n; i++) { unsigned v = 0; while ((rnd() & 3) && v < 255) v++; p[i] = (uint8_t)v; } break;
+    }
+}
+static void attack(const uint8_t *z, size_t zn, uint8_t *r, size_t n) {
+    /* truncated and corrupted payloads: no crash (ASan), and nothing accepted that is longer or shorter than asked */
+    if (zn > 1) { size_t cut = zn - 1 - rnd() % (zn - 1 < 64 ? zn - 1 : 64); CHECK(kolmo_krans_decompress(z, cut, r, n) != 0, "accepted a truncated payload (%zu of %zu)", cut, zn); }
+    uint8_t *y = malloc(zn + 1);
+    for (int t = 0; t < 6; t++) {
+        memcpy(y, z, zn);
+        for (int f = 0; f < 1 + t; f++) { const size_t at = t < 3 ? rnd() % (zn < 48 ? zn : 48) : rnd() % zn; y[at] ^= (uint8_t)(1u << (rnd() & 7)); }   /* headers first, then anywhere */
+        kolmo_krans_decompress(y, zn, r, n);
+        if (n > 1) kolmo_krans_decompress(y, zn, r, n - 1);
+    }
+    memcpy(y, z, zn); y[zn] = 0;
+    CHECK(kolmo_krans_decompress(y, zn + 1, r, n) != 0, "accepted a trailing byte");
+    if (n > 1) CHECK(kolmo_krans_decompress(z, zn, r, n - 1) != 0, "accepted a wrong raw length");
+    free(y);
+}
+static void roundtrip(const uint8_t *in, size_t n, const kolmo_krans_params *pp, const char *what) {
+    const size_t cap = kolmo_krans_bound(n); uint8_t *z = malloc(cap + 1), *r = malloc(n + 2);
+    const size_t zn = kolmo_krans_compress(in, n, z, cap, pp);
+    ncase++;
+    if (!n) { CHECK(zn == 0, "%s: empty input coded", what); free(z); free(r); return; }
+    CHECK(zn && zn <= cap, "%s n %zu: refused or past the bound (%zu > %zu)", what, n, zn, cap);
+    if (zn) {
+        r[n] = 0xA5; r[n + 1] = 0x5A;
+        const int rc = kolmo_krans_decompress(z, zn, r, n);
+        CHECK(!rc && !memcmp(r, in, n) && r[n] == 0xA5 && r[n + 1] == 0x5A, "%s n %zu: round trip", what, n);
+        if (z[0] == 2) ncoded++;
+        attack(z, zn, r, n);
+        /* the encoder never writes past cap: a tight buffer either fits or is refused */
+        if (zn > 8) { uint8_t *t = malloc(zn - 1); const size_t q = kolmo_krans_compress(in, n, t, zn - 1, pp); CHECK(q == 0 || q <= zn - 1, "%s: wrote past cap", what); free(t); }
+    }
+    free(z); free(r);
+}
+/* every context set of the format on one input */
+static void forced(const uint8_t *in, size_t n, size_t W, unsigned C) {
+    static const uint32_t lags[][4] = {{1, 0, 0, 0}, {3, 2, 1, 4}, {0, 0, 0, 0} /* W-based, filled below */, {70000, 1, 0, 0}};
+    static const uint8_t nl[] = {1, 4, 4, 2};
+    char what[96];
+    for (unsigned eq = 0; eq <= 2; eq++) for (unsigned bq = 0; bq <= 3; bq++) for (unsigned mk = 0; mk <= 2; mk++) {
+        kolmo_krans_params p = {0}; p.force = 1; p.eq = (uint8_t)eq; p.bq = (uint8_t)bq; p.mk = (uint8_t)mk;
+        p.ls = (uint8_t)(rnd() % 6); p.mb = (uint8_t)(rnd() & 3); p.P = (uint8_t)(1 + rnd() % 8);
+        while (((eq == 1 ? 17u : eq == 2 ? 9u : 1u) * (bq == 1 ? 256u : bq == 2 ? 6u : bq == 3 ? 11u : 1u)) * p.P > KRANS_NCTX_MAX) p.P--;   /* the format's limit */
+        if (!p.P) continue;                                          /* 17 x 256 contexts: not a valid set (refused in test_invalid) */
+        p.pf = (uint8_t)(bq && p.P > 1 ? rnd() & 1 : 0);
+        if (eq) { const unsigned a = rnd() % 4; p.nlag = nl[a]; memcpy(p.lag, lags[a], sizeof p.lag); if (a == 2) { p.lag[0] = C; p.lag[1] = (uint32_t)W; p.lag[2] = (uint32_t)(W + C); p.lag[3] = (uint32_t)(W - C); } }
+        p.max_tables = (uint8_t)(rnd() % 3 == 0 ? 255 : rnd() % 3 == 0 ? 2 : 0);
+        p.chunk = rnd() % 4 == 0 ? 4096 + rnd() % 60000 : 0;
+        snprintf(what, sizeof what, "forced eq %u bq %u mk %u ls %u P %u mb %u pf %u nlag %u", eq, bq, mk, p.ls, p.P, p.mb, p.pf, p.nlag);
+        roundtrip(in, n, &p, what);
+    }
+}
+static void test_invalid(void) {
+    /* a valid coded chunk, then every reserved or inconsistent header value must be refused */
+    uint8_t in[4096], z[8192], r[4096]; gen(in, sizeof in, 8, 0, 1);
+    kolmo_krans_params p = {0}; p.force = 1; p.ls = 2; p.P = 3; p.mb = 1; p.eq = 1; p.bq = 2; p.pf = 1; p.nlag = 2; p.lag[0] = 3; p.lag[1] = 96;
+    const size_t zn = kolmo_krans_compress(in, sizeof in, z, sizeof z, &p);
+    CHECK(zn && z[0] == 2 && !kolmo_krans_decompress(z, zn, r, sizeof in) && !memcmp(in, r, sizeof in), "invalid-header base case");
+    if (!zn || z[0] != 2) return;
+    /* layout: kind, m uv (2 bytes: 4096), b0, b1, nlag, lag 3, lag 96, T - 1, bits... */
+    const size_t b0 = 3, b1 = 4, nlag = 5, lag0 = 6, tm1 = 8; uint8_t y[8192];
+#define BAD(EDIT, WHY) do { memcpy(y, z, zn); EDIT; CHECK(kolmo_krans_decompress(y, zn, r, sizeof in) != 0, "accepted: %s", WHY); } while (0)
+    BAD(y[0] = 3, "chunk kind 3");
+    BAD(y[b0] = (uint8_t)((y[b0] & ~7) | 6), "log2 S = 6");
+    BAD(y[b1] |= 128, "b1 bit 7");
+    BAD(y[b1] = (uint8_t)((y[b1] & ~3) | 3), "eq 3");
+    BAD(y[b1] = (uint8_t)((y[b1] & ~0x30) | 0x30), "mk 3");
+    BAD(y[b1] = (uint8_t)(y[b1] & ~0x0C), "pf without bq");
+    BAD(y[nlag] = 0, "no lags with eq");
+    BAD(y[nlag] = 5, "five lags");
+    BAD(y[lag0] = 0, "lag 0");
+    BAD(y[tm1] = 255, "256 tables");
+    BAD(y[tm1] = (uint8_t)(y[tm1] + 1), "one table more than coded");
+    BAD(y[1] = (uint8_t)(y[1] ^ 1), "raw length off by one");
+#undef BAD
+    /* chunk lengths: zero, larger than the output, larger than the format allows */
+    { const uint8_t a[] = {0, 0}; CHECK(kolmo_krans_decompress(a, sizeof a, r, 1) != 0, "accepted an empty chunk"); }
+    { const uint8_t a[] = {1, 5, 7}; CHECK(kolmo_krans_decompress(a, sizeof a, r, 4) != 0, "accepted a fill past the output"); }
+    { const uint8_t a[] = {1, 4, 7}; CHECK(!kolmo_krans_decompress(a, sizeof a, r, 4) && r[0] == 7 && r[3] == 7, "fill chunk"); }
+    { const uint8_t a[] = {0, 3, 'a', 'b', 'c'}; CHECK(!kolmo_krans_decompress(a, sizeof a, r, 3) && !memcmp(r, "abc", 3), "stored chunk"); }
+    { const uint8_t a[] = {0, 3, 'a', 'b'}; CHECK(kolmo_krans_decompress(a, sizeof a, r, 3) != 0, "accepted a short stored chunk"); }
+    CHECK(kolmo_krans_decompress(NULL, 0, r, 0) == 0, "empty leaf");
+    CHECK(kolmo_krans_decompress(z, 0, r, 1) != 0, "accepted nothing for one byte");
+    /* an encoder asked for a context set outside the format stores the chunk instead */
+    kolmo_krans_params q = {0}; q.force = 1; q.eq = 1; q.bq = 1; q.P = 1; q.nlag = 1; q.lag[0] = 1;
+    const size_t sn = kolmo_krans_compress(in, sizeof in, y, sizeof y, &q);
+    CHECK(sn && y[0] == 0 && !kolmo_krans_decompress(y, sn, r, sizeof in) && !memcmp(in, r, sizeof in), "invalid set stored");
+}
+/* 600 bytes of a small text pattern with a slow drift, coded order 1 with two states (written by this encoder on
+ * 24 November 2026; tests/test_krans_golden.h). The stream is pinned, not the encoder: test-krans 1 golden prints it. */
+static void pinned_input(uint8_t *p) { static const char t[] = "abracadabra kolmo rans; "; for (unsigned i = 0; i < 600; i++) p[i] = (uint8_t)(t[(i + i / 97) % 24] + (i % 131 == 0)); }
+#include "test_krans_golden.h"
+static void test_pinned(void) {
+    uint8_t in[600], r[600]; pinned_input(in);
+    CHECK(pinned_z[0] == 2 && !kolmo_krans_decompress(pinned_z, sizeof pinned_z, r, 600) && !memcmp(r, in, 600), "pinned stream");
+}
+int main(int argc, char **argv) {
+    const int iters = argc > 1 ? atoi(argv[1]) : 1;
+    if (argc > 2 && !strcmp(argv[2], "golden")) {                 /* prints the pinned stream (maintenance; not run by make) */
+        kolmo_krans_params p = {0}; p.force = 1; p.ls = 1; p.P = 1; p.bq = 1; uint8_t in[600], z[1024]; pinned_input(in);
+        const size_t zn = kolmo_krans_compress(in, 600, z, sizeof z, &p);
+        printf("static const uint8_t pinned_z[%zu] = {", zn); for (size_t q = 0; q < zn; q++) printf("%s%u", q ? "," : "", z[q]); printf("};\n");
+        return 0;
+    }
+    static const size_t sizes[] = {0, 1, 2, 3, 15, 16, 17, 63, 64, 65, 255, 256, 511, 512, 1000, 2047, 2048, 4095, 4096, 4097, 9000, 33000, 70001, 150000, 300000};
+    uint8_t *buf = malloc(1u << 20);
+    for (int it = 0; it < iters; it++) {
+        for (int kind = 0; kind <= 8; kind++) for (size_t si = 0; si < sizeof sizes / sizeof sizes[0]; si++) {
+            const size_t n = sizes[si]; const unsigned C = 1 + rnd() % 4; const size_t W = (size_t)C * (8 + rnd() % 200); char what[64];
+            gen(buf, n, kind, W, C);
+            snprintf(what, sizeof what, "default kind %d", kind); roundtrip(buf, n, NULL, what);
+            for (int ef = 1; ef <= 2; ef++) {
+                kolmo_krans_params p = {0}; p.effort = (uint8_t)ef; snprintf(what, sizeof what, "effort %d kind %d", ef, kind); roundtrip(buf, n, &p, what);
+                p.stride = (uint32_t)W; p.step = (uint8_t)C; snprintf(what, sizeof what, "image %zux%u effort %d kind %d", W, C, ef, kind); roundtrip(buf, n, &p, what);
+            }
+            if (n >= 16 && (n <= 9000 || (si + (size_t)kind + (size_t)it) % 3 == 0)) forced(buf, n, W, C);
+        }
+        /* several chunks, a short last one, a hint that does not divide */
+        gen(buf, 1u << 20, 7, 1536, 3);
+        { kolmo_krans_params p = {0}; p.stride = 1536; p.step = 3; p.chunk = 300000; roundtrip(buf, (1u << 20) - 77, &p, "chunks of 300000"); }
+        { kolmo_krans_params p = {0}; p.stride = 1537; p.step = 3; roundtrip(buf, 500000, &p, "stride not a multiple of the step"); }
+        { kolmo_krans_params p = {0}; p.stride = 1 << 23; p.step = 1; roundtrip(buf, 500000, &p, "stride longer than the leaf"); }
+        { kolmo_krans_params p = {0}; p.stride = 6; p.step = 9; roundtrip(buf, 5000, &p, "step out of range"); }
+    }
+    free(buf);
+    test_invalid(); test_pinned();
+    printf("test_krans: %lu cases (%lu with a coded first chunk), %d failures\n", ncase, ncoded, fails);
+    return fails ? 1 : 0;
+}
