+/* Context rANS inside the container (review R02; opt-in KOLMO_NATIVE=rans, set by this test before the first call):
+ *   - leaf codec 33: an IMG8 graph block coded with it is smaller than without, decodes only with version 11 leaves
+ *     allowed, and is refused as a block codec or inside a pre-11 graph; damaged graph payloads never crash;
+ *   - block codec 34 (16-bit image residual words): payload round trip from a transformed stream with and without
+ *     the skip and trailing bytes, refusal inside a graph, wrong lengths, truncated and damaged payloads;
+ *   - whole frames of an 8-bit colour image, a grey image and a 16-bit image in every mode: version 11, the same
+ *     bytes with 1 and 4 threads, round trip, range read, a version-10 header refused, damaged frames never decode
+ *     to other bytes; the 16-bit image's frame holds a codec 34 block at balanced and hc.
+ * make check-krans builds it plain and with ASan/UBSan. */
+#include "../src/kolmo.c"
+#include <stdio.h>
+
+static uint64_t st = 0x9e3779b97f4a7c15ULL;
+static uint64_t rv(void) { st ^= st << 13; st ^= st >> 7; st ^= st << 17; return st; }
+#define FAIL(...) do { fprintf(stderr, "test_krans_frames: " __VA_ARGS__); fprintf(stderr, " (line %d)\n", __LINE__); return 1; } while (0)
+
+/* a smooth field with busy and quiet regions: 8-bit samples, C channels that follow each other */
+static void image8(uint8_t *p, size_t w, size_t h, unsigned C) {
+    for (size_t y = 0; y < h; y++) for (size_t x = 0; x < w; x++) {
+        const int busy = 1 + 10 * (int)(((x / 40) + (y / 30)) % 3), base = (int)(128 + 60 * sin((double)x / 37) + 50 * cos((double)y / 23)), d = (int)(rv() % (uint64_t)(2 * busy + 1)) - busy;
+        for (unsigned k = 0; k < C; k++) { int v = base + d + (int)(rv() % 3) - 1 + 9 * (int)k; p[(y * w + x) * C + k] = (uint8_t)(v < 0 ? 0 : v > 255 ? 255 : v); }
+    }
+}
+static void image16(uint8_t *p, size_t w, size_t h) {
+    for (size_t y = 0; y < h; y++) for (size_t x = 0; x < w; x++) {
+        const int busy = 2 + 40 * (int)(((x / 50) + (y / 40)) % 4);
+        const int v = (int)(2000 + 900 * sin((double)x / 41) + 700 * cos((double)y / 29)) + (int)(rv() % (uint64_t)(2 * busy + 1)) - busy;
+        p[2 * (y * w + x)] = (uint8_t)v; p[2 * (y * w + x) + 1] = (uint8_t)(v >> 8);
+    }
+}
+static int leaf33(void) {
+    enum { W = 300, H = 200, C = 3 }; const size_t n = (size_t)W * H * C, cap = n + n / 8 + 4096;
+    uint8_t *s = malloc(n), *a = malloc(cap), *b = malloc(cap), *o = malloc(n + 1);
+    if (!s || !a || !b || !o) FAIL("alloc");
+    image8(s, W, H, C);
+    codec_ctx x = {0}, y = {0}; y.no_f2 = 1;
+    const size_t za = kg_encode_img8(&x, C_ZSTD, 3, s, n, (size_t)W * C, C, 0, a, cap), zb = kg_encode_img8(&y, C_ZSTD, 3, s, n, (size_t)W * C, C, 0, b, cap);
+    if (!za || !zb || za >= zb || !x.used_f2) FAIL("codec 33 not used by the image leaf (%zu with, %zu without)", za, zb);
+    if (!kg_decode(&x, a, za, o, n)) FAIL("a codec 33 leaf decoded without version 11");
+    x.allow_f2 = 1;
+    if (kg_decode(&x, a, za, o, n) || memcmp(o, s, n)) FAIL("codec 33 leaf: round trip");
+    for (int t = 0; t < 300; t++) {                               /* damaged graph payloads: no crash */
+        memcpy(b, a, za); const size_t q = t < 150 ? (size_t)(rv() % 64) : (size_t)(rv() % za); b[q] ^= (uint8_t)(1 + rv() % 255);
+        kg_decode(&x, b, za, o, n); if (t % 7 == 0) kg_decode(&x, b, za - 1 - (size_t)(rv() % 40), o, n);
+    }
+    /* the leaf payload alone is not a block codec, and codec 34 is not a leaf */
+    uint8_t leaf[4096], r[4096]; kolmo_krans_params kp = {0}; const size_t zl = kolmo_krans_compress(s, 4000, leaf, sizeof leaf, &kp);
+    codec_ctx z = {0};
+    if (!zl || !codec_decompress(&z, C_KRANS, leaf, zl, r, 4000)) FAIL("codec 33 accepted outside a version 11 graph");
+    z.allow_f2 = 1;
+    if (codec_decompress(&z, C_KRANS, leaf, zl, r, 4000) || memcmp(r, s, 4000)) FAIL("codec 33 payload");
+    if (!leaf_sub_codec_ok(C_KRANS) || leaf_sub_codec_ok(C_KI16)) FAIL("sub-codec rule");
+    codec_ctx_free(&x); codec_ctx_free(&y); codec_ctx_free(&z);
+    free(s); free(a); free(b); free(o); return 0;
+}
+static int block34(void) {
+    enum { W = 257, N = 257 * 120 };
+    for (int v = 0; v < 4; v++) {
+        const size_t skip = (size_t)(v & 1), tail = v >= 2 ? 1 : 0, n = 12 + skip + 2 * (size_t)N + tail, cap = n + n / 8 + 4096;
+        uint8_t *t = malloc(n), *c = malloc(cap), *o = malloc(n + 1), *d = malloc(cap); uint16_t *img = malloc(2 * (size_t)N);
+        if (!t || !c || !o || !d || !img) FAIL("alloc");
+        image16((uint8_t *)img, W, N / W);
+        t[0] = 0; t[1] = (uint8_t)skip; t[2] = 2; t[3] = 0; const uint32_t w32 = W, n32 = N; memcpy(t + 4, &w32, 4); memcpy(t + 8, &n32, 4);
+        if (skip) t[12] = 0x5A;
+        img16_fwd(img, N, W, 2, t + 12 + skip, t + 12 + skip + N);
+        if (tail) t[n - 1] = 0xA5;
+        codec_ctx x = {0};
+        const size_t z = ki16_compress(t, n, 1 + (v & 1), c, cap);
+        if (!z || z >= n) FAIL("codec 34: not coded (variant %d: %zu of %zu)", v, z, n);
+        if (codec_decompress(&x, C_KI16, c, z, o, n) || memcmp(o, t, n)) FAIL("codec 34: round trip (variant %d)", v);
+        x.allow_f2 = 1; if (!codec_decompress(&x, C_KI16, c, z, o, n)) FAIL("codec 34 accepted as a graph leaf");
+        x.allow_f2 = 0;
+        if (!codec_decompress(&x, C_KI16, c, z, o, n - 2) || !codec_decompress(&x, C_KI16, c, z - 1, o, n) || !codec_decompress(&x, C_KI16, c, 11, o, n)) FAIL("codec 34: wrong length accepted");
+        for (int q = 0; q < 200; q++) {
+            memcpy(d, c, z); const size_t at = q < 80 ? (size_t)(rv() % 48) : (size_t)(rv() % z); d[at] ^= (uint8_t)(1 + rv() % 255);
+            codec_decompress(&x, C_KI16, d, z, o, n); if (q % 5 == 0) codec_decompress(&x, C_KI16, d, z - (size_t)(rv() % 30), o, n);
+        }
+        codec_ctx_free(&x); free(t); free(c); free(o); free(d); free(img);
+    }
+    return 0;
+}
+static int frame_case(const char *what, const uint8_t *s, size_t n, kolmo_mode m, int want_codec) {
+    kolmo_params p = {m, 0, 4, 0, 1}; size_t cap = kolmo_bound(n, &p); uint8_t *f = malloc(cap), *g = malloc(cap), *o = malloc(n + 1);
+    if (!f || !g || !o) FAIL("alloc");
+    int64_t z = kolmo_compress(s, n, f, cap, &p); p.threads = 1; int64_t z2 = kolmo_compress(s, n, g, cap, &p);
+    if (z <= 0 || z != z2 || memcmp(f, g, (size_t)z)) FAIL("%s mode %d: not the same bytes with 1 and 4 threads", what, m);
+    if (m != KOLMO_RT && f[4] != 11) FAIL("%s mode %d: version %d, want 11", what, m, f[4]);
+    if (want_codec >= 0) { int has = 0; for (uint32_t i = 0; i < get32(f + 20); i++) has |= f[HDR + i * IDX + 12] == want_codec; if (!has) FAIL("%s mode %d: no codec %d block", what, m, want_codec); }
+    if (kolmo_decompress(f, (size_t)z, o, n, 3) != (int64_t)n || memcmp(o, s, n)) FAIL("%s mode %d: round trip", what, m);
+    uint8_t rr[100]; uint64_t off = n / 3;
+    if (kolmo_read_range(f, (size_t)z, off, 100, rr, 2) != 100 || memcmp(rr, s + off, 100)) FAIL("%s mode %d: range read", what, m);
+    if (f[4] == 11) { memcpy(g, f, (size_t)z); g[4] = 10; uint32_t hc = kolmo_crc32c(0, g, 28); hc = kolmo_crc32c(hc, g + HDR, (size_t)get32(g + 20) * IDX); put32(g + 28, hc);
+        if (want_codec >= 0 && kolmo_decompress(g, (size_t)z, o, n, 1) >= 0) FAIL("%s mode %d: version 11 content read as version 10", what, m); }
+    for (int t = 0; t < 60; t++) {
+        memcpy(g, f, (size_t)z); size_t q = HDR + (size_t)(rv() % (uint64_t)(z - HDR)); g[q] ^= (uint8_t)(1 + rv() % 255);
+        int64_t got = kolmo_decompress(g, (size_t)z, o, n, 1);
+        if (got >= 0 && (got != (int64_t)n || memcmp(o, s, n))) FAIL("%s mode %d: damaged frame decoded to other bytes", what, m);
+    }
+    free(f); free(g); free(o); return 0;
+}
+int main(void) {
+    setenv("KOLMO_NATIVE", "rans", 1);                              /* read once, by the first call below */
+    if (!(kolmo_native_flags() & KN_RANS)) FAIL("the opt-in is not read");
+    if (leaf33() || block34()) return 1;
+    static const kolmo_mode modes[] = {KOLMO_RT, KOLMO_FAST, KOLMO_ECO, KOLMO_HC, KOLMO_MAX};
+    enum { W = 480, H = 360 };
+    uint8_t *ppm = malloc(64 + (size_t)W * H * 3), *pgm = malloc(64 + (size_t)W * H), *i16 = malloc(2 * (size_t)W * H);
+    if (!ppm || !pgm || !i16) FAIL("alloc");
+    const size_t hp = (size_t)sprintf((char *)ppm, "P6\n%d %d\n255\n", W, H), hg = (size_t)sprintf((char *)pgm, "P5\n%d %d\n255\n", W, H);
+    image8(ppm + hp, W, H, 3); image8(pgm + hg, W, H, 1); image16(i16, W, H);
+    for (size_t k = 0; k < sizeof modes / sizeof modes[0]; k++) {
+        const kolmo_mode m = modes[k];
+        if (frame_case("colour image", ppm, hp + (size_t)W * H * 3, m, m == KOLMO_FAST ? C_GRAPH : -1)) return 1;   /* the other modes may plan these synthetic images otherwise */
+        if (frame_case("grey image", pgm, hg + (size_t)W * H, m, m == KOLMO_FAST ? C_GRAPH : -1)) return 1;
+        if (frame_case("16-bit image", i16, 2 * (size_t)W * H, m, m == KOLMO_FAST || m == KOLMO_HC ? C_KI16 : -1)) return 1;
+    }
+    free(ppm); free(pgm); free(i16);
+    printf("test_krans_frames: OK\n");
+    return 0;
+}
