diff --git a/fuzz/fuzz_native_lz.c b/fuzz/fuzz_native_lz.c
new file mode 100644
index 00000000..dae1b675
--- /dev/null
+++ b/fuzz/fuzz_native_lz.c
@@ -0,0 +1,42 @@
+/* libFuzzer target for Kolmo's own LZ decoders, called directly (no container, no checksum in the way): KLZH2
+ * (codec 32), KLZH (29) and KLZ (28). fuzz_codecs.c does not reach them. Only src/algo is needed:
+ *   clang -g -O1 -fsanitize=fuzzer,address,undefined -Isrc fuzz/fuzz_native_lz.c src/algo/klz.c src/algo/khuf.c -o fuzz_native_lz
+ * Input: sel u8 | n (3 bytes, little-endian: the decoded length, capped at 1 MiB) | payload.
+ *   sel & 3 = 0: the payload is decoded as a KLZH2 block of n bytes; 1: as KLZH; 2: as KLZ (any result, no crash, no
+ *   read or write outside the buffers);
+ *   sel & 3 = 3: round trip: the payload is coded with KLZH2 at level 1 + (sel >> 2) % 9 and must decode back exactly
+ *   (a mismatch traps: a real bug); the valid block is then damaged at positions taken from the payload and decoded
+ *   again, also with a wrong length. */
+#include "algo/klz.h"
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define FZ_MAXN (1u << 20)
+int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
+    if (size < 4) return 0;
+    const unsigned sel = data[0]; size_t n = (size_t)data[1] | (size_t)data[2] << 8 | (size_t)data[3] << 16;
+    const uint8_t *p = data + 4; size_t pn = size - 4;
+    if (n > FZ_MAXN) n = FZ_MAXN;
+    if ((sel & 3) != 3) {
+        uint8_t *out = malloc(n ? n : 1);
+        if (!out) return 0;
+        if ((sel & 3) == 0) kolmo_klzh2_decompress(p, pn, out, n);
+        else if ((sel & 3) == 1) kolmo_klzh_decompress(p, pn, out, n);
+        else kolmo_klz_decompress(p, pn, out, n);
+        free(out); return 0;
+    }
+    const size_t cap = kolmo_klzh_bound(pn); uint8_t *z = malloc(cap), *r = malloc(pn + 2);
+    if (!z || !r) { free(z); free(r); return 0; }
+    const size_t zn = kolmo_klzh2_compress(p, pn, z, cap, 1 + (int)((sel >> 2) % 9));
+    if (zn) {
+        if (zn >= pn || kolmo_klzh2_decompress(z, zn, r, pn) || memcmp(r, p, pn)) __builtin_trap();
+        for (size_t k = 0; k + 2 < pn && k < 24; k += 3) z[(p[k] | (size_t)p[k + 1] << 8) % zn] ^= (uint8_t)(p[k + 2] | 1);
+        kolmo_klzh2_decompress(z, zn, r, pn);
+        kolmo_klzh2_decompress(z, zn, r, pn + 1);
+        if (pn) kolmo_klzh2_decompress(z, zn, r, pn - 1);
+        kolmo_klzh2_decompress(z, zn / 2, r, pn);
+    }
+    free(z); free(r);
+    return 0;
+}
