+        printf("};\n");
+    }
+    printf("static const struct { int id; const uint8_t *p; size_t n; } KLZH2_FRAMES[] = {");
+    for (int k = 0; k < 7; k++) printf("%s{%d, KLZH2_F%d, sizeof KLZH2_F%d}", k ? ", " : "", ID[k], k, k);
+    printf("};\n");
+    free(in); free(z);
+}
