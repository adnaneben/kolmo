+/* Frozen bytes. gold(): inputs that depend on nothing but this function. (1) KLZ and KLZH (codecs 28, 29) must keep
+ * writing the bytes rc3 wrote: the hashes below were taken from the rc3 sources (commit 5071f388) and must never be
+ * edited. (2) KLZH2 frames written when codec 32 was introduced (tests/klzh2_frames.h) must keep decoding: an encoder
+ * may change, the format may not. `test-native emit` prints that header from the current encoder. */
+static size_t gold(int id, uint8_t *p) {
+    static const size_t N[8] = {700, 5000, 12000, 200000, 5000, 260, 3000, 12000};
+    size_t n = N[id]; uint32_t x = 12345u + (uint32_t)id * 7919u;
+#define GR() (x = x * 1664525u + 1013904223u, x >> 8)
+    for (size_t i = 0; i < n;) {
+        if (id == 0 || id == 5) { static const char *w[] = {"alpha ", "beta ", "gamma, ", "delta.\n", "kolmo ", "of the "}; const char *q = w[GR() % 6]; while (*q && i < n) p[i++] = (uint8_t)*q++; }
+        else if (id == 1 || id == 3) { uint32_t rec = (uint32_t)(i / 16), v = (uint32_t)(i % 16); p[i++] = (uint8_t)(v < 4 ? rec >> (8 * v) : v < 8 ? (GR() & 3) : v < 12 ? 0 : 'A' + (GR() % (id == 1 ? 5 : 23))); }
+        else if (id == 6) p[i++] = 'z';
+        else if (id == 7) { uint32_t v = GR() % 1000; p[i++] = (uint8_t)(v < 500 ? 'e' + v % 3 : v < 900 ? 'a' + v % 17 : v % 61 + 40); }
+        else if (id == 2) { size_t r = 1 + GR() % 400; uint8_t c = (uint8_t)(GR() % 7 ? 'a' + GR() % 20 : GR()); while (r-- && i < n) { p[i++] = c; if (GR() % 5 == 0) c++; } }
+        else { p[i] = (uint8_t)(i < 1200 ? GR() : p[i - 1000 - (GR() % 3 ? 0 : 5)]); i++; }
+    }
+#undef GR
+    return n;
+}
+#include "klzh2_frames.h"
+static const struct { int id, kind, level; uint64_t h; } GOLD29[] = {
+#include "klz_rc3_hashes.h"
+};
+static void test_frozen(void) {
+    uint8_t *in = malloc(200000), *z = malloc(260000), *r = malloc(200000);
+    for (size_t k = 0; k < sizeof GOLD29 / sizeof *GOLD29; k++) {
+        size_t n = gold(GOLD29[k].id, in), zn = GOLD29[k].kind ? kolmo_klzh_compress(in, n, z, 260000, GOLD29[k].level) : kolmo_klz_compress(in, n, z, 260000, GOLD29[k].level);
+        CHECK(kolmo_khash64(z, zn, zn) == GOLD29[k].h, "%s level %d input %d: the bytes written differ from rc3's", GOLD29[k].kind ? "klzh" : "klz", GOLD29[k].level, GOLD29[k].id);
+    }
+#ifdef KLZ_TEST_HOOKS
+    memset(kolmo_klzh2_seen, 0, sizeof kolmo_klzh2_seen);
+#endif
+    for (size_t k = 0; k < sizeof KLZH2_FRAMES / sizeof *KLZH2_FRAMES; k++) {
+        size_t n = gold(KLZH2_FRAMES[k].id, in);
+        CHECK(!kolmo_klzh2_decompress(KLZH2_FRAMES[k].p, KLZH2_FRAMES[k].n, r, n) && !memcmp(r, in, n), "klzh2 frozen frame %zu (input %d) does not decode", k, KLZH2_FRAMES[k].id);
+    }
+#ifdef KLZ_TEST_HOOKS   /* the frozen frames between them hold every chunk kind */
+    for (int a = 0; a < 3; a++) for (int b = 0; b < (a == 2 ? 3 : 4); b++) CHECK(kolmo_klzh2_seen[a][b], "klzh2 frozen frames: chunk kind [%d][%d] is in none of them", a, b);
+#endif
+    free(in); free(z); free(r);
+}
+static void emit(void) {
+    uint8_t *in = malloc(200000), *z = malloc(260000); static const int ID[7] = {0, 1, 2, 4, 5, 6, 7}, LV[7] = {1, 3, 5, 3, 9, 2, 1};
+    printf("/* KLZH2 (codec 32) frames frozen when the codec was introduced: written by `test-native emit`, never edited.\n * Each must decode to gold(id) (tests/test_native.c). */\n");
+    for (int k = 0; k < 7; k++) {
+        size_t n = gold(ID[k], in), zn = kolmo_klzh2_compress(in, n, z, 260000, LV[k]);
+        printf("static const uint8_t KLZH2_F%d[%zu] = {", k, zn);
