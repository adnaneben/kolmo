+/* nsym 0: literals; else a code stream (the caller checks that every symbol is below nsym) */
+static int kz2_get_section(const uint8_t *in, size_t cn, size_t *i, uint8_t *out, size_t len, int nsym, const uint16_t *pre) {
+    for (size_t o = 0; o < len;) {
+        uint64_t hd, z; if (kz_get_uv(in, cn, i, &hd)) return -1;
+        const uint64_t m = hd >> 2; const unsigned mode = (unsigned)(hd & 3);
