+ * table each. Returns the bytes written, or (size_t)-1 when cap is too small. */
+static size_t kz2_put_section(const uint8_t *s, const uint32_t *cut, size_t nc, int nsym, int lmax, const uint16_t *pre, int hbias, uint8_t *o, size_t cap, uint8_t *tmp, uint16_t *pr, uint8_t *sb) {
