+        if (c == 0) { s += 1 + (int)kz_bget(r, 3); if (s > last) return -1; continue; }
+        if (c == 1) v = 1;
+        else if (c == 2) v = 2 + kz_bget(r, 2);
+        else { const int k = (int)kz_bget(r, 4); if (k > KZA_MAXLOG) return -1; v = 5 + (1u << k) + kz_bget(r, k); }
+        f[s++] = (uint16_t)v; sum += v;
+        if (sum > (1u << L)) return -1;
+    }
