+        else if (mode == 1) { if (*i >= cn) return -1; memset(out + o, in[(*i)++], m); }
+        else {   /* code streams: tANS with its own table (2), with the predefined one or a khuf block (3); literals: a khuf block (2) or tANS over bytes (3) */
+            if (kz_get_uv(in, cn, i, &z) || z > cn - *i) return -1;
