+    const uint8_t *lp = lit, *le = lit + nl; const unsigned raw = fl ? 7 : 64;   /* offset codes from raw on have their low four bits in fo */
+    uint32_t LB[72], MB[KZ2_NML]; uint8_t LN[72], MN[KZ2_NML]; kz_ltab(LB, LN); kz2_mtab(MB, MN);
+    uint8_t *op = out, *oe = out + n; uint32_t rep[3] = {1, 4, 8};
+    for (size_t k = 0; k < ns; k++) {
