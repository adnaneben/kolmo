+static void kz2_mtab(uint32_t base[KZ2_NML], uint8_t nb[KZ2_NML]) {
+    for (unsigned c = 0; c < KZ2_NML; c++) {
+        if (c < 48) { base[c] = c; nb[c] = 0; continue; }
+        int h = 5 + (int)(c - 48) / 2; base[c] = (1u << h) | ((c & 1u) << (h - 1)); nb[c] = (uint8_t)(h - 1);
+    }
