+/* ---- static tANS for the code streams (tokens and length codes) ----
+ * Written for Kolmo from the construction in J. Duda, "Asymmetric numeral systems: entropy coding combining speed of
+ * Huffman coding with compression rate of arithmetic coding" (arXiv:1311.2540), tabled variant; no code from FSE.
+ * A table of M = 2^L states; symbol s owns f[s] of them (the f sum to M), spread by bit reversal: the states whose
+ * L-bit reversed index lies in [cum[s], cum[s] + f[s]). Taken in increasing order the states of s are numbered
+ * v = f[s] .. 2 f[s] - 1; a state decodes as its symbol, reads nb = L - floor(log2 v) bits and moves to state
+ * (v << nb) + bits - M. Two states take the symbols alternately (even and odd positions) over one bit stream. The
+ * encoder runs backwards from state 0 for both and writes the bits in decoding order, so the decoder reads forwards
+ * and must end with both states 0. */
+#define KZA_MAXLOG 11
+static void kza_spread(const uint16_t *f, int nsym, int L, uint8_t *slot) {
+    uint32_t x = 0; const uint32_t top = (1u << L) >> 1;
+    for (int s = 0; s < nsym; s++) for (uint32_t k = 0; k < f[s]; k++) {
+        slot[x] = (uint8_t)s;
+        uint32_t bit = top; while (x & bit) { x ^= bit; bit >>= 1; }   /* the next index, bit-reversed */
+        x |= bit;
+    }
+}
+/* counts scaled to a sum of 2^L, every present symbol at least 1; the rounding error goes where it costs least: one
+ * state at a time is taken from the symbol that loses the fewest bits by it (or given to the one that gains the most),
+ * the lowest symbol among equals. The candidates sit in a binary heap keyed by (cost, symbol), so a chunk with many
+ * rare symbols (short literal chunks of binary data) costs O((symbols + states moved) log symbols). */
+static inline uint64_t kza_nkey(const uint32_t *c, const uint16_t *f, unsigned s, int up) {
+    const uint64_t g = up ? (uint64_t)c[s] * (kz2_lg(f[s] + 1u) - kz2_lg(f[s])) : (uint64_t)c[s] * (kz2_lg(f[s]) - kz2_lg(f[s] - 1u));
+    return ((up ? ((uint64_t)1 << 48) - g : g) << 8) | s;   /* g < 2^41: the smallest key is the choice */
+}
+static inline void kza_sift(uint64_t *h, int n, int i) {
+    const uint64_t v = h[i];
+    for (;;) {
+        int k = 2 * i + 1;
+        if (k >= n) break;
+        if (k + 1 < n && h[k + 1] < h[k]) k++;
+        if (h[k] >= v) break;
+        h[i] = h[k]; i = k;
+    }
+    h[i] = v;
+}
+static void kza_normalize(const uint32_t *c, int nsym, uint32_t t, int L, uint16_t *f) {
+    const int64_t M = (int64_t)1 << L; int64_t sum = 0;
+    for (int s = 0; s < nsym; s++) {
+        uint64_t v = c[s] ? (((uint64_t)c[s] << L) + t / 2) / t : 0;
+        if (c[s] && !v) v = 1;
+        f[s] = (uint16_t)v; sum += (int64_t)v;
+    }
+    if (sum == M) return;
+    const int up = sum < M; uint64_t h[256]; int n = 0;
+    for (int s = 0; s < nsym; s++) if (f[s] > (up ? 0 : 1)) h[n++] = kza_nkey(c, f, (unsigned)s, up);
+    for (int i = n / 2; i-- > 0;) kza_sift(h, n, i);
+    for (; sum != M; sum += up ? 1 : -1) {   /* M >= the number of present symbols, so a candidate is left while sum > M */
+        const unsigned b = (unsigned)(h[0] & 255);
+        f[b] = (uint16_t)(f[b] + (up ? 1 : -1));
+        if (up || f[b] > 1) h[0] = kza_nkey(c, f, b, up); else h[0] = h[--n];
+        kza_sift(h, n, 0);
+    }
+}
+/* the table header: L - 5 (3 bits), the last present symbol (7 bits; 8 for the literal alphabet), then for symbols 0 .. last a 2-bit class:
+ * 0: a run of 1-8 absent symbols (3 bits), 1: f = 1, 2: f = 2-5 (2 bits), 3: f = 5 + u, u >= 1 as floor(log2 u)
+ * (4 bits) and the bits below its top bit */
+static int kza_put_counts(kz_bw *w, const uint16_t *f, int last, int L, int nsym) {
+    if (kz_bput(w, (uint32_t)L - 5, 3) || kz_bput(w, (uint32_t)last, nsym > 128 ? 8 : 7)) return -1;
+    for (int s = 0; s <= last;) {
+        const uint32_t v = f[s];
+        if (!v) { int r = 1; while (r < 8 && !f[s + r]) r++; if (kz_bput(w, (uint32_t)(r - 1) << 2, 5)) return -1; s += r; continue; }
+        if (v == 1) { if (kz_bput(w, 1, 2)) return -1; }
+        else if (v < 6) { if (kz_bput(w, 2 | (v - 2) << 2, 4)) return -1; }
+        else { const uint32_t u = v - 5; const int k = kz_hb(u); if (kz_bput(w, 3 | (uint32_t)k << 2, 6) || kz_bput(w, u - (1u << k), k)) return -1; }
+        s++;
+    }
+    return 0;
+}
+static int kza_get_counts(kz_br *r, int nsym, uint16_t *f, int *Lp) {
+    kz_refill(r);
+    const int L = 5 + (int)kz_bget(r, 3), last = (int)kz_bget(r, nsym > 128 ? 8 : 7); uint32_t sum = 0;
+    if (L > KZA_MAXLOG || last >= nsym) return -1;
+    memset(f, 0, (size_t)nsym * sizeof *f);
+    for (int s = 0; s <= last;) {
+        kz_refill(r);
+        const unsigned c = kz_bget(r, 2); uint32_t v;
+        if (c == 0) { s += 1 + (int)kz_bget(r, 3); if (s > last) return -1; continue; }
+        if (c == 1) v = 1;
+        else if (c == 2) v = 2 + kz_bget(r, 2);
+        else { const int k = (int)kz_bget(r, 4); if (k > KZA_MAXLOG) return -1; v = 5 + (1u << k) + kz_bget(r, k); }
+        f[s++] = (uint16_t)v; sum += v;
+        if (sum > (1u << L)) return -1;
+    }
+    *Lp = L; return sum == (1u << L) ? 0 : -1;
+}
+/* The table a chunk of m symbols with histogram cnt (nsym <= 256 symbols, at least two present) would be coded with,
+ * and what it would cost. pre NULL: the chunk's own table: counts scaled into f[0..nsym), *Lp its log2 size (at most
+ * lmax). pre: the predefined counts (f is not written). Returns the estimated payload in 1/256 bit (table header, start
+ * states, code lengths as log2 of the state shares; integers only), or UINT64_MAX when pre has no state for a symbol. */
+#define KZA_WIDE 256
+static uint64_t kza_plan(const uint32_t *cnt, int nsym, size_t m, int lmax, const uint16_t *pre, uint16_t *f, int *Lp) {
+    int mp = 0, last = 0; for (int q = 0; q < nsym; q++) if (cnt[q]) { mp++; last = q; if (pre && !pre[q]) return UINT64_MAX; }
+    int L = kz_hb((uint32_t)m) - 2; const int lo = kz_hb((uint32_t)(mp - 1)) + 2;   /* about m / 4 states: a larger table costs more header than it saves */
+    if (L < lo) L = lo;
+    if (L < 5) L = 5;
+    if (L > lmax) L = lmax;
+    if (pre) L = KZ2_PRE_LOG; else kza_normalize(cnt, nsym, (uint32_t)m, L, f);
+    const uint16_t *const g = pre ? pre : f; uint64_t bits = (uint64_t)(m >= KZA_WIDE ? 4 : 2) * (uint64_t)L * 256;
+    for (int q = 0; q <= last; q++) if (cnt[q]) bits += (uint64_t)cnt[q] * ((uint32_t)L * 256 - kz2_lg(g[q]));
+    if (!pre) {   /* the header, as kza_put_counts writes it */
+        uint32_t hb = 3 + (nsym > 128 ? 8 : 7);
+        for (int q = 0; q <= last;) {
+            const uint32_t v = f[q];
+            if (!v) { int r = 1; while (r < 8 && !f[q + r]) r++; hb += 5; q += r; continue; }
+            hb += v == 1 ? 2 : v < 6 ? 4 : 6 + (uint32_t)kz_hb(v - 5); q++;
+        }
+        bits += (uint64_t)hb * 256;
+    }
+    *Lp = L; return bits;
+}
+/* m symbols as one tANS payload with the table of 2^L states given by the counts f (kza_plan; hdr: the table header is
+ * written, 0 for a predefined table).
+ * m < KZA_WIDE: one bit stream: the table header, two start states (L bits each), the bits; symbol i belongs to
+ * state i & 1. m >= KZA_WIDE: four states (symbol i: state i & 3) over two bit streams: length of the first uv | the
+ * first (table header, four start states, the bits of the even symbols) | the second (the bits of the odd symbols).
+ * pr: m words of scratch, sb: m + 64 bytes of scratch. Returns the size, or 0 when it does not fit in cap. */
+static size_t kza_encode(const uint8_t *s, size_t m, int nsym, const uint16_t *f, int L, int hdr, uint8_t *o, size_t cap, uint16_t *pr, uint8_t *sb) {
+    int last = 0; for (int q = 0; q < nsym; q++) if (f[q]) last = q;
+    const uint32_t M = 1u << L; const int wide = m >= KZA_WIDE; const size_t sm = wide ? 3 : 1;
+    uint16_t cum[257], k[256], thr[256], nxt[1 << KZA_MAXLOG]; uint8_t mb[256], slot[1 << KZA_MAXLOG];
+    cum[0] = 0;
+    for (int q = 0; q < nsym; q++) {
+        cum[q + 1] = (uint16_t)(cum[q] + f[q]); k[q] = cum[q]; mb[q] = 0; thr[q] = 0;
+        if (f[q]) { mb[q] = (uint8_t)(L - kz_hb(f[q])); thr[q] = (uint16_t)(f[q] << mb[q]); }
+    }
+    kza_spread(f, nsym, L, slot);
+    for (uint32_t x = 0; x < M; x++) nxt[k[slot[x]]++] = (uint16_t)(M + x);
+    uint32_t X[4] = {M, M, M, M};
+    for (size_t i = m; i-- > 0;) {   /* from state x, symbol q: nb low bits out, v = x >> nb in [f, 2f), next state the (v - f)-th of q */
+        const unsigned q = s[i]; const uint32_t x = X[i & sm]; const int nb = mb[q] - (x < thr[q]);
+        pr[i] = (uint16_t)((x & ((1u << nb) - 1)) | (uint32_t)nb << 12);
+        X[i & sm] = nxt[cum[q] + (x >> nb) - f[q]];
+    }
+    if (cap < 16) return 0;
+    kz_bw w = {0, 0, o + (wide ? 5 : 0), o + cap};
+    if ((hdr && kza_put_counts(&w, f, last, L, nsym)) || kz_bput(&w, X[0] - M, L) || kz_bput(&w, X[1] - M, L)) return 0;
+    if (!wide) {
+        for (size_t i = 0; i < m; i++) if (kz_bput(&w, pr[i] & 0xFFFu, pr[i] >> 12)) return 0;
+        if (w.p + 8 > w.e) return 0;
+        kz_w64(w.p, w.b); w.p += (w.c + 7) >> 3;
+        return (size_t)(w.p - o);
+    }
+    kz_bw v = {0, 0, sb, sb + m + 64}; size_t i = 0;
+    if (kz_bput(&w, X[2] - M, L) || kz_bput(&w, X[3] - M, L)) return 0;
+    for (; i + 2 <= m; i += 2) if (kz_bput(&w, pr[i] & 0xFFFu, pr[i] >> 12) || kz_bput(&v, pr[i + 1] & 0xFFFu, pr[i + 1] >> 12)) return 0;
+    if (i < m && kz_bput(&w, pr[i] & 0xFFFu, pr[i] >> 12)) return 0;
+    if (w.p + 8 > w.e || v.p + 8 > v.e) return 0;
+    kz_w64(w.p, w.b); w.p += (w.c + 7) >> 3; kz_w64(v.p, v.b); v.p += (v.c + 7) >> 3;
+    const size_t za = (size_t)(w.p - (o + 5)), zb = (size_t)(v.p - sb), h = kz_put_uv(o, za);
+    if (h + za + zb > cap) return 0;
+    memmove(o + h, o + 5, za); memcpy(o + h + za, sb, zb);
