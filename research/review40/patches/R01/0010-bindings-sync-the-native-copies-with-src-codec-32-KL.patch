+static inline int kza_br_end(const kz_br *r, const uint8_t *s, size_t z) {   /* the reader consumed all of s[0..z) but the padding of the last byte */
+    const int64_t used = (int64_t)(r->p - s) * 8 - r->c;
+    return used <= (int64_t)z * 8 && used > ((int64_t)z - 1) * 8;
