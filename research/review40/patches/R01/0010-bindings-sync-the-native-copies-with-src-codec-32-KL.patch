+        kz2_get_section(in, cn, &i, cd + ns + nx + nr, ns - nr, KZ2_NML, KZ2_PRE_MLN) || kz2_get_section(in, cn, &i, cd + 2 * ns + nx, nf, 16, KZ2_PRE_NIB)) goto out;
+    mx = 0; for (size_t k = 0; k < nx; k++) mx = lx[k] > mx ? lx[k] : mx;
+    if (mx >= 72) goto out;
+    mx = 0; for (size_t k = 0; k < ns; k++) mx = mr[k] > mx ? mr[k] : mx;
+    if (mx >= KZ2_NML) goto out;
+    mx = 0; for (size_t k = 0; k < nf; k++) mx = fo[k] > mx ? fo[k] : mx;
+    if (mx >= 16) goto out;
