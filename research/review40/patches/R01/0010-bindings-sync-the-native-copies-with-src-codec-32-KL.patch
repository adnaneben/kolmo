+    uint8_t *lit = malloc(n + 16), *cd = malloc(5 * (ns + 1)), *xb = malloc(ns * 12 + 64), *tmp = malloc(KHUF_BLOCK_MAX + 1024);
+    uint32_t *cut = malloc(6 * (nc + 1) * sizeof *cut); const size_t ps = ns > KZ2_LIT_ANS ? ns : KZ2_LIT_ANS;   /* the longest tANS chunk */
