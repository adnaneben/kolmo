+/* match length - 4 = v: v < 48 is code v; else h = floor(log2 v), code 48 + 2 (h - 5) + the bit below the top, h - 1 extra bits */
+static inline unsigned kz2_mcode(uint32_t v, uint32_t *ex, int *nb) {
+    if (v < 48) { *nb = 0; *ex = 0; return v; }
+    int h = kz_hb(v); *nb = h - 1; *ex = v & ((1u << (h - 1)) - 1);
+    return 48u + 2u * (unsigned)(h - 5) + ((v >> (h - 1)) & 1u);
