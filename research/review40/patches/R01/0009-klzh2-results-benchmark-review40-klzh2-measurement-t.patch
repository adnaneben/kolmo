+import glob,re,sys,collections
+# usage: sum.py DIR PREFIX TN [a:b ...] -> totals per codec and pairs (sizes exact; speeds indicative)
+d,pre,tn=sys.argv[1],sys.argv[2],sys.argv[3]; T=collections.OrderedDict(); per=collections.defaultdict(dict)
+for f in sorted(glob.glob(f"{d}/{pre}-{tn}-*.txt")):
+    name=f.split(f"-{tn}-")[1][:-4]
+    for l in open(f):
+        m=re.match(r"(\S+)\s+T\d+\s+in\s+(\d+)\s+out\s+(\d+)\s+ratio\s+\S+\s+c\s+(\S+) MB/s\s+d\s+(\S+) MB/s",l)
+        if not m: continue
+        c,i,o,cs,ds=m.group(1),int(m.group(2)),int(m.group(3)),float(m.group(4)),float(m.group(5))
+        t=T.setdefault(c,[0,0,0.0,0.0]); t[0]+=i; t[1]+=o; t[2]+=i/cs/1e6; t[3]+=i/ds/1e6; per[c][name]=o
+for c,t in T.items(): print(f"{c:7s} in {t[0]:>10} out {t[1]:>10} c {t[0]/t[2]/1e6:7.1f} MB/s d {t[0]/t[3]/1e6:7.1f} MB/s")
+for a,r in [p.split(":") for p in sys.argv[4:]]:
+    if a in T and r in T:
+        x,y=T[a],T[r]; print(f"  {a} vs {r}: size {100*(x[1]/y[1]-1):+.2f}%  compress {y[2]/x[2]:.2f}x  decompress {y[3]/x[3]:.2f}x")
+        print("     "+"  ".join(f"{n} {100*(per[a][n]/per[r][n]-1):+.2f}%" for n in per[a]))
