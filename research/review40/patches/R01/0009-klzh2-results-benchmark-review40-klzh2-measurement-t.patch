+#!/bin/sh
+# KLZH2 (codec 32) against KLZH (29) and zstd -1/-3: the measurements of RESULTS.md.
+# usage: sh benchmark/review40/klzh2/run.sh DATA_DIR OUT_DIR [MEASURE]
+#   DATA_DIR: silesia/ (12 files) and enwik8_10m.   MEASURE: a wrapper that serialises timed runs (optional), e.g.
+#   "python3 tools/measure.py --runs 1 --"
+# Needs build/libvendor.a (make all). Sizes are exact; speeds are what the host gives.
+set -e
+D=$1; O=$2; M=$3; mkdir -p "$O"
+cc -O3 -march=native -DXXH_NAMESPACE=ZSTD_ -Isrc -Ivendor/zstd -Ivendor/lz4 -Ivendor/brotli/include -Ivendor/xz \
+   benchmark/rc3w2/native/natbench.c src/algo/khuf.c src/algo/klz.c src/algo/klzma.c src/algo/khash.c src/arch/xxh3.c \
+   build/libvendor.a -o "$O/natbench" -lpthread -lm
+python3 benchmark/review40/klzh2/mkstop.py src/algo/klz.c "$O/klz-stop.c"
+cc -O3 -march=native -DKLZ_C="\"$O/klz-stop.c\"" -Isrc -Isrc/algo benchmark/review40/klzh2/dec_time.c src/algo/khuf.c -o "$O/dec_time"
+cc -O2 -DKLZ_TEST_HOOKS -DKLZ_C="\"$PWD/src/algo/klz.c\"" -Isrc -Isrc/algo benchmark/review40/klzh2/chunks.c src/algo/khuf.c -o "$O/chunks"
+nat() { tag=$1; c=$2; t=$3; b=$4; shift 4
+  for f in "$@"; do n=$(basename "$f"); $M sh -c "$O/natbench $c $t $b 3 $f > $O/$tag-T$t-$n.txt 2>&1"; done; }
+nat v6 zstd1,klzh1,k2h1,zstd3,klzh3,k2h3,klzh5,k2h5,zstd9,klzh7,k2h7 1 4096 "$D"/silesia/* "$D"/enwik8_10m
+nat v6 zstd1,klzh1,k2h1,zstd3,klzh3,k2h3 4 4096 "$D"/silesia/* "$D"/enwik8_10m
+for b in 4 32 256; do nat v6small$b lz4,klz1,zstd1,klzh1,k2h1,zstd3,klzh3,k2h3 1 $b "$D"/silesia/xml "$D"/silesia/dickens "$D"/silesia/osdb; done
+python3 benchmark/review40/klzh2/sum.py "$O" v6 T1 k2h1:zstd1 k2h1:klzh1 k2h3:zstd3 k2h3:klzh3 k2h5:klzh5 k2h7:klzh7 k2h7:zstd9
+python3 benchmark/review40/klzh2/sum.py "$O" v6 T4 k2h1:zstd1 k2h1:klzh1 k2h3:zstd3 k2h3:klzh3
+for b in 4 32 256; do python3 benchmark/review40/klzh2/sum.py "$O" v6small$b T1 k2h1:zstd1 k2h1:klzh1 k2h3:zstd3 k2h3:klzh3; done
+"$O/dec_time" 1 4096 9 "$D"/silesia/*; "$O/dec_time" 3 4096 9 "$D"/silesia/*
