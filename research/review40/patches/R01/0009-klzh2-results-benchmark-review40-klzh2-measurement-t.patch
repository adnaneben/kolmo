+++ b/benchmark/review40/klzh2/chunks.c
@@ -0,0 +1,17 @@
+/* R01 tool: chunk kinds a KLZH2 decoder meets. usage: chunks LEVEL BLOCK_KIB FILE... (klz.c with KLZ_TEST_HOOKS) */
+#include KLZ_C
+#include <stdio.h>
+int main(int argc, char **argv) {
+    int level = atoi(argv[1]); size_t blk = (size_t)atoi(argv[2]) << 10;
+    for (int a = 3; a < argc; a++) {
+        FILE *f = fopen(argv[a], "rb"); if (!f) return 1; fseek(f, 0, SEEK_END); size_t N = (size_t)ftell(f); rewind(f);
+        uint8_t *in = malloc(N + 64); if (fread(in, 1, N, f) != N) return 1; fclose(f);
+        size_t cap = kolmo_klzh_bound(blk); uint8_t *z = malloc(cap), *back = malloc(blk + 64); memset(kolmo_klzh2_seen, 0, sizeof kolmo_klzh2_seen); size_t nb = 0;
+        for (size_t b = 0; b < N; b += blk) { size_t n = N - b < blk ? N - b : blk; size_t zn = n >= 64 ? kolmo_klzh2_compress(in + b, n, z, cap, level) : 0; nb++; if (zn && kolmo_klzh2_decompress(z, zn, back, n)) return 2; }
+        const char *nm = strrchr(argv[a], '/'); nm = nm ? nm + 1 : argv[a];
+        printf("%s L%d blocks %zu | literal chunks: stored %u one-byte %u khuf %u tANS %u | code chunks: stored %u one-byte %u own-table %u predefined %u | tANS payloads: 2 states %u, 4 states %u, predefined %u, khuf code blocks %u\n", nm, level, nb,
+               kolmo_klzh2_seen[0][0], kolmo_klzh2_seen[0][1], kolmo_klzh2_seen[0][2], kolmo_klzh2_seen[0][3], kolmo_klzh2_seen[1][0], kolmo_klzh2_seen[1][1], kolmo_klzh2_seen[1][2], kolmo_klzh2_seen[1][3], kolmo_klzh2_seen[2][0], kolmo_klzh2_seen[2][1], kolmo_klzh2_seen[2][2], kolmo_klzh2_seen[2][3]);
+        free(in); free(z); free(back);
+    }
+    return 0;
+}
diff --git a/benchmark/review40/klzh2/dec_time.c b/benchmark/review40/klzh2/dec_time.c
new file mode 100644
index 00000000..8fa3b239
--- /dev/null
+++ b/benchmark/review40/klzh2/dec_time.c
@@ -0,0 +1,29 @@
+/* R01 tool: decode time of KLZH (codec 29) and KLZH2 (codec 32) split into entropy decode of the streams and the
+ * sequence loop. usage: dec_time LEVEL BLOCK_KIB REPS FILE...   (includes a klz.c variant with a stop flag) */
+#include KLZ_C
+#include <stdio.h>
+#include <time.h>
+static double now(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return t.tv_sec + t.tv_nsec * 1e-9; }
+int main(int argc, char **argv) {
+    int level = atoi(argv[1]); size_t blk = (size_t)atoi(argv[2]) << 10; int reps = atoi(argv[3]);
+    for (int a = 4; a < argc; a++) {
+        FILE *f = fopen(argv[a], "rb"); if (!f) return 1; fseek(f, 0, SEEK_END); size_t N = (size_t)ftell(f); rewind(f);
+        uint8_t *in = malloc(N + 64); if (fread(in, 1, N, f) != N) return 1; fclose(f);
+        size_t nb = (N + blk - 1) / blk, cap = kolmo_klzh_bound(blk); uint8_t *back = malloc(blk + 64);
+        const char *nm = strrchr(argv[a], '/'); nm = nm ? nm + 1 : argv[a];
+        for (int c = 0; c < 2; c++) {
+            uint8_t **z = malloc(nb * sizeof *z); size_t *zn = malloc(nb * sizeof *zn), tot = 0;
+            for (size_t b = 0; b < nb; b++) { size_t n = N - b * blk < blk ? N - b * blk : blk; z[b] = malloc(cap); zn[b] = n >= 64 ? (c ? kolmo_klzh2_compress : kolmo_klzh_compress)(in + b * blk, n, z[b], cap, level) : 0; tot += zn[b] ? zn[b] : n; }
+            double t[2] = {1e9, 1e9};
+            for (int r = 0; r < reps; r++) for (int st = 1; st >= 0; st--) {
+                kz_stop = st; double t0 = now();
+                for (size_t b = 0; b < nb; b++) { size_t n = N - b * blk < blk ? N - b * blk : blk; if (zn[b] && (c ? kolmo_klzh2_decompress : kolmo_klzh_decompress)(z[b], zn[b], back, n)) return 2; }
+                double d = now() - t0; if (d < t[st]) t[st] = d;
+            }
+            printf("%s\tL%d\t%s\tout=%zu\tstreams %.1f ms\tsequence loop %.1f ms\ttotal %.1f ms = %.0f MB/s\n", nm, level, c ? "klzh2" : "klzh", tot, t[1] * 1e3, (t[0] - t[1]) * 1e3, t[0] * 1e3, N / t[0] / 1e6);
+            for (size_t b = 0; b < nb; b++) free(z[b]); free(z); free(zn);
+        }
+        free(in); free(back);
+    }
+    return 0;
+}
diff --git a/benchmark/review40/klzh2/e2e.sh b/benchmark/review40/klzh2/e2e.sh
new file mode 100755
index 00000000..dbcc3fbb
--- /dev/null
+++ b/benchmark/review40/klzh2/e2e.sh
@@ -0,0 +1,21 @@
+#!/bin/sh
+# End to end through the CLI, one thread: sizes and round trips with the library coders, KOLMO_NATIVE=lz and lz2, and
+# the two compatibility directions against an rc3 binary.
+# usage: sh benchmark/review40/klzh2/e2e.sh NEW_KOLMO RC3_KOLMO SCRATCH_DIR OUT.tsv FILE...
+# columns: file, mode, coders, frame bytes, exit status, round trip, compatibility note
+N=$1; B=$2; S=$3; out=$4; shift 4
+for f in "$@"; do n=$(basename "$f")
+  for m in speed balanced; do
+    for nat in none lz lz2; do
+      if [ $nat = none ]; then env -u KOLMO_NATIVE "$N" -m $m -T 1 "$f" "$S/t.k" >/dev/null 2>&1; else KOLMO_NATIVE=$nat "$N" -m $m -T 1 "$f" "$S/t.k" >/dev/null 2>&1; fi
+      rc=$?; sz=$(stat -c %s "$S/t.k")
+      "$N" -d -T 1 "$S/t.k" "$S/t.back" >/dev/null 2>&1; cmp -s "$S/t.back" "$f" && rt=OK || rt=FAIL
+      x=-
+      if [ $nat = none ]; then env -u KOLMO_NATIVE "$B" -m $m -T 1 "$f" "$S/b.k" >/dev/null 2>&1; cmp -s "$S/b.k" "$S/t.k" && x=same-bytes-as-rc3 || x=DIFFERS-from-rc3; fi
+      if [ $nat = lz ]; then KOLMO_NATIVE=lz "$B" -m $m -T 1 "$f" "$S/b.k" >/dev/null 2>&1; cmp -s "$S/b.k" "$S/t.k" && x=same-bytes-as-rc3 || x=DIFFERS-from-rc3
+        "$N" -d -T 1 "$S/b.k" "$S/b.back" >/dev/null 2>&1; cmp -s "$S/b.back" "$f" && x="$x,rc3-frame-decodes" || x="$x,rc3-frame-FAILS"; fi
+      if [ $nat = lz2 ]; then "$B" -d -T 1 "$S/t.k" "$S/b.back" >/dev/null 2>&1 && x=rc3-ACCEPTED || x=rc3-refuses; fi
+      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$n" $m $nat "$sz" $rc $rt "$x" >> "$out"
+    done
+  done
+done
diff --git a/benchmark/review40/klzh2/mkstop.py b/benchmark/review40/klzh2/mkstop.py
new file mode 100644
index 00000000..1e8b5c7e
--- /dev/null
+++ b/benchmark/review40/klzh2/mkstop.py
@@ -0,0 +1,11 @@
+# usage: mkstop.py SRC/algo/klz.c OUT.c   -> klz.c with a flag that stops both KLZH decoders after the entropy stage,
+# for dec_time.c (which times the entropy decode of the streams and the sequence loop separately).
+import sys
+s = open(sys.argv[1]).read()
+for a in ("    kz_br br = {0, 0, in + i, in + cn};\n    const uint8_t *lp = lit, *le = lit + nl, *llc = st[1]",
+          "    kz_br br = {0, 0, in + i, in + cn};\n    const uint8_t *lp = lit, *le = lit + nl; const unsigned raw"):
+    assert s.count(a) == 1
+    s = s.replace(a, "    if (kz_stop) { rc = 0; goto out; }\n" + a)
+a = "/* ---------------- KLZH: entropy-coded streams ---------------- */"
+assert s.count(a) == 1
+open(sys.argv[2], "w").write(s.replace(a, "static int kz_stop;\n" + a))
