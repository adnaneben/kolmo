@@ -0,0 +1,15 @@
+# ab.py T ROUNDS OUT.jsonl FRAME... : decode each frame with build A (rc3 58f7cee) and build B (this branch), alternating
+# the order every round, best decode speed of ROUNDS rounds (each round is dbench's best of >= 1 s); one thread count.
+import sys, subprocess, json, os
+T, R, out = sys.argv[1], int(sys.argv[2]), sys.argv[3]
+A, B = os.environ.get('DB_A', '/home/user/dbench-base2'), os.environ.get('DB_B', '/home/user/dbench-new')
+f = open(out, 'a')
+for k in sys.argv[4:]:
+    best = {'A': 0, 'B': 0}; info = None
+    for r in range(R):
+        for lab, b in ([('A', A), ('B', B)] if r % 2 == 0 else [('B', B), ('A', A)]):
+            o = subprocess.run([b, '-d', '-T', T, '-s', os.environ.get('SECS', '1'), k], check=True, capture_output=True, text=True).stdout.split()
+            info = (int(o[1]), int(o[2])); best[lab] = max(best[lab], float(o[3]))
+    row = {'frame': k.replace('/home/user/frames/', ''), 'T': int(T), 'size': info[0], 'csize': info[1], 'A_MBs': best['A'], 'B_MBs': best['B'], 'gain': best['B'] / best['A'] - 1}
+    f.write(json.dumps(row) + '\n'); f.flush()
+    print(f"{row['frame']:40s} T{T} {info[1]:>10d} A {best['A']:8.1f} B {best['B']:8.1f} {row['gain']:+.1%}", flush=True)
diff --git a/benchmark/rc3w3/decmap/bwtbench.c b/benchmark/rc3w3/decmap/bwtbench.c
new file mode 100644
index 00000000..1e3e74ea
--- /dev/null
+++ b/benchmark/rc3w3/decmap/bwtbench.c
@@ -0,0 +1,39 @@
+/* bwtbench: codec 18 decode time against the number of sampled BWT indexes (decmap lane, rc3 wave 3).
+ *   bwtbench FILE... : for each index count k (default, 16, 32, 64, 128, 255) prints payload bytes and the best decode
+ *   time at 1 thread and at all threads (separate runs), plus the inverse-BWT stage alone. */
+#define _GNU_SOURCE
+#include "codecs/bwt_stream.h"
+#include "algo/qlfc.h"
+#include "algo/sais/sais.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+static double now(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return t.tv_sec + t.tv_nsec * 1e-9; }
+int main(int argc, char **argv) {
+    int T = (int)sysconf(_SC_NPROCESSORS_ONLN);
+    for (int a = 1; a < argc; a++) {
+        FILE *f = fopen(argv[a], "rb"); fseek(f, 0, SEEK_END); int n = (int)ftell(f); fseek(f, 0, SEEK_SET);
+        uint8_t *s = malloc(n), *c = malloc((size_t)n + 4096), *d = malloc((size_t)n + 64);
+        if (fread(s, 1, n, f) != (size_t)n) return 1; fclose(f);
+        int ks[] = {0, 16, 32, 64, 128, 255};
+        for (int ki = 0; ki < 6; ki++) {
+            kolmo_bwt_params P = KOLMO_BWT_DEFAULTS;
+            if (ks[ki]) { int r = 1; while (((int64_t)n - 1) >> r > ks[ki]) r++; P.index_log2 = r; }  /* at most k indexes (of the LZP output: fewer) */
+            int z = kolmo_bwt_compress(s, c, (size_t)n + 4096, n, &P, T);
+            if (z <= 0) { printf("fail\n"); return 1; }
+            int k = c[1 + 2 + 4 + 1 + ((c[0] & 4) ? 0 : -2)];   /* k byte */
+            double bt[2] = {1e9, 1e9};
+            for (int ti = 0; ti < 2; ti++) for (int rep = 0; rep < 6; rep++) {
+                double t0 = now(); int r = kolmo_bwt_decompress(c, (size_t)z, d, n, ti ? T : 1); double t = now() - t0;
+                if (r || memcmp(d, s, n)) { printf("MISMATCH\n"); return 1; }
+                if (t < bt[ti]) bt[ti] = t;
+            }
+            printf("%-28s k=%3d bytes=%d  dec T1 %.1f MB/s  T%d %.1f MB/s\n", strrchr(argv[a], '/') ? strrchr(argv[a], '/') + 1 : argv[a], k, z, n / bt[0] / 1e6, T, n / bt[1] / 1e6);
+            fflush(stdout);
+        }
+        free(s); free(c); free(d);
+    }
+    return 0;
+}
diff --git a/benchmark/rc3w3/decmap/dbench.c b/benchmark/rc3w3/decmap/dbench.c
new file mode 100644
index 00000000..72c9d2b9
--- /dev/null
+++ b/benchmark/rc3w3/decmap/dbench.c
@@ -0,0 +1,50 @@
+/* dbench: decode benchmark of Kolmo frames (decmap lane, rc3 wave 3).
+ *   dbench -c MODE [-l level] [-T threads] FILE OUT.k      compress once (writes the frame)
+ *   dbench -d [-T threads] [-s seconds] FRAME... print size, decode MB/s (best of repeated in-memory runs, >= 3 runs
+ *                                                  and >= s seconds), output checked against FRAME's .src sibling hash
+ * -r N: at least N runs (default 3).
+ * MODE: speed balanced eco hc ratio x. One thread count per run; never mixed. */
+#define _GNU_SOURCE
+#include "kolmo.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+static double now(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return t.tv_sec + t.tv_nsec * 1e-9; }
+static uint8_t *slurp(const char *f, size_t *n) { FILE *fp = fopen(f, "rb"); if (!fp) { perror(f); exit(1); }
+    fseek(fp, 0, SEEK_END); *n = (size_t)ftell(fp); fseek(fp, 0, SEEK_SET); uint8_t *b = malloc(*n + 1);
+    if (fread(b, 1, *n, fp) != *n) exit(1); fclose(fp); return b; }
+static uint64_t fnv(const uint8_t *p, size_t n) { uint64_t h = 1469598103934665603ull; for (size_t i = 0; i < n; i++) h = (h ^ p[i]) * 1099511628211ull; return h; }
+int main(int argc, char **argv) {
+    int T = 1, opt, dec = 0, level = 0, minr = 3; double secs = 1.0; const char *mode = NULL;
+    while ((opt = getopt(argc, argv, "c:dl:T:s:r:")) != -1) switch (opt) {
+        case 'c': mode = optarg; break; case 'd': dec = 1; break; case 'l': level = atoi(optarg); break;
+        case 'T': T = atoi(optarg); break; case 's': secs = atof(optarg); break; case 'r': minr = atoi(optarg); break; default: return 2; }
+    if (mode) {
+        size_t n; uint8_t *s = slurp(argv[optind], &n);
+        kolmo_params p = {KOLMO_FAST, level, T, 0, 1};
+        p.mode = !strcmp(mode, "speed") ? KOLMO_RT : !strcmp(mode, "balanced") ? KOLMO_FAST : !strcmp(mode, "eco") ? KOLMO_ECO :
+                 !strcmp(mode, "hc") ? KOLMO_HC : !strcmp(mode, "ratio") ? KOLMO_MAX : KOLMO_ULTRA;
+        size_t cap = n + n / 2 + (1 << 20); uint8_t *d = malloc(cap);
+        double t0 = now(); int64_t r = kolmo_compress(s, n, d, cap, &p); double tc = now() - t0;
+        if (r <= 0) { fprintf(stderr, "compress failed %lld\n", (long long)r); return 1; }
+        FILE *f = fopen(argv[optind + 1], "wb"); fwrite(d, 1, (size_t)r, f); fclose(f);
+        char hp[4096]; snprintf(hp, sizeof hp, "%s.h", argv[optind + 1]); f = fopen(hp, "w");
+        fprintf(f, "%zu %016llx\n", n, (unsigned long long)fnv(s, n)); fclose(f);
+        printf("%s %s %zu %lld %.3f\n", argv[optind], mode, n, (long long)r, tc); return 0;
+    }
+    if (!dec) return 2;
+    for (int a = optind; a < argc; a++) {
+        size_t z; uint8_t *s = slurp(argv[a], &z); char hp[4096]; snprintf(hp, sizeof hp, "%s.h", argv[a]);
+        size_t n = 0; unsigned long long h = 0; FILE *f = fopen(hp, "r"); if (!f || fscanf(f, "%zu %llx", &n, &h) != 2) return 1; fclose(f);
+        uint8_t *d = malloc(n + 64); double best = 1e9, tot = 0; int runs = 0;
+        while (runs < minr || tot < secs) {
+            double t0 = now(); int64_t r = kolmo_decompress(s, z, d, n + 64, T); double t = now() - t0;
+            if (r != (int64_t)n || (runs == 0 && fnv(d, n) != h)) { fprintf(stderr, "MISMATCH %s\n", argv[a]); return 1; }
+            if (t < best) best = t; tot += t; runs++; if (runs > 200) break;
+        }
+        printf("%s %zu %zu %.2f\n", argv[a], n, z, n / best / 1e6); fflush(stdout); free(d); free(s);
+    }
+    return 0;
+}
diff --git a/benchmark/rc3w3/decmap/khufbench.c b/benchmark/rc3w3/decmap/khufbench.c
new file mode 100644
index 00000000..98c9ff82
--- /dev/null
+++ b/benchmark/rc3w3/decmap/khufbench.c
@@ -0,0 +1,25 @@
+/* khufbench: fixed (table) cost of a khuf block decode against the per-byte cost (decmap lane). khufbench FILE */
+#define _GNU_SOURCE
+#include "algo/khuf.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+static double now(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return t.tv_sec + t.tv_nsec * 1e-9; }
+int main(int argc, char **argv) {
+    FILE *f = fopen(argv[1], "rb"); static uint8_t s[1 << 20], c[(1 << 20) + 4096], d[1 << 17];
+    size_t n = fread(s, 1, sizeof s, f); fclose(f);
+    size_t sz[] = {4096, 16384, 65536, 131072};
+    for (int k = 0; k < 4; k++) {
+        size_t b = sz[k], nb = n / b, z[512], off[512], o = 0;
+        for (size_t i = 0; i < nb; i++) { off[i] = o; z[i] = kolmo_khuf_compress(s + i * b, b, c + o, sizeof c - o); o += z[i]; }
+        double best = 1e9;
+        for (int rep = 0; rep < 20; rep++) {
+            double t0 = now();
+            for (size_t i = 0; i < nb; i++) if (z[i] && (kolmo_khuf_decompress(c + off[i], z[i], d, b) || memcmp(d, s + i * b, b))) { puts("bad"); return 1; }
+            double t = now() - t0; if (t < best) best = t;
+        }
+        printf("block %6zu: %zu blocks, coded %zu bytes, %.3f ns/byte, %.0f ns/block\n", b, nb, o, best / (nb * b) * 1e9, best / nb * 1e9);
+    }
+    return 0;
+}
