diff --git a/tests/test_krans_modes.py b/tests/test_krans_modes.py
new file mode 100644
index 00000000..a2b0f853
--- /dev/null
+++ b/tests/test_krans_modes.py
@@ -0,0 +1,57 @@
+"""Context rANS leaves (codec 33) in the CLI: every mode with KOLMO_NATIVE=rans (alone and with all), 1 and 4 threads,
+on generated inputs (colour and grey images with a PNM header, a headerless image, integers, floats, a table, text,
+random bytes, zeros, a tiny file). Each frame must decode to its input with KOLMO_NATIVE unset (the decoder needs no
+opt-in), the output with 1 and 4 threads must be the same, no frame may be larger than the one written without the
+opt-in at the same mode by more than the leaf rule allows (codec 33 is kept only when smaller: never larger), and the
+image frames at balanced must actually use it (smaller than without). The default output is covered by the
+determinism check.
+
+usage: python3 tests/test_krans_modes.py build/kolmo WORK_DIR"""
+import os, random, struct, subprocess, sys
+K, W = sys.argv[1], sys.argv[2]
+os.makedirs(W, exist_ok=True)
+rnd = random.Random(20261124)
+def image(w, h, c):
+    px = bytearray(); row = [128] * (w * c)
+    for y in range(h):
+        for x in range(w):
+            busy = 1 + 12 * (((x // 40) + (y // 30)) % 3)
+            d = rnd.randint(-busy, busy)
+            for k in range(c):
+                i = x * c + k; v = (row[i] + (px[-c] if x else row[i])) // 2 + d + rnd.randint(-1, 1)
+                v = max(0, min(255, v)); px.append(v); row[i] = v
+    return bytes(px)
+files = {
+    "colour.ppm": b"P6\n320 200\n255\n" + image(320, 200, 3),
+    "grey.pgm": b"P5\n400 300\n255\n" + image(400, 300, 1),
+    "rgba.u8": image(256, 256, 4),
+    "ints.i32": b"".join(struct.pack("<i", 1000 + i * 3 + rnd.randint(-5, 5)) for i in range(60000)),
+    "floats.f64": b"".join(struct.pack("<d", 20.0 + rnd.gauss(0, 1)) for i in range(20000)),
+    "table.csv": ("id,x,y\n" + "".join(f"{i},{rnd.randint(0, 999)},{rnd.random():.3f}\n" for i in range(20000))).encode(),
+    "text.txt": " ".join(rnd.choice(["kolmo", "leaf", "rans", "context", "table", "the", "of"]) for _ in range(40000)).encode(),
+    "random.bin": bytes(rnd.getrandbits(8) for _ in range(70000)),
+    "zeros.bin": bytes(100000),
+    "tiny.txt": b"a",
+}
+bad = 0
+env0 = {k: v for k, v in os.environ.items() if k != "KOLMO_NATIVE"}
+for name, data in files.items():
+    src = os.path.join(W, name); open(src, "wb").write(data)
+    for mode in ("speed", "balanced", "eco", "hc", "ratio"):
