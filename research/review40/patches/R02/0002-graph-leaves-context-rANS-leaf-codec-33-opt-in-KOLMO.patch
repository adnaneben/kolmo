+/* Codec 33: context rANS leaf (graph leaves; container version 11). Review R02, claim ctx-rans-leaf.
+ *
+ * Kolmo's own static rANS coder with static context modelling (src/algo/krans.c; the format is in krans.h): order 0
+ * with compact tables, order 1, and for image residuals the quantised magnitudes of the already decoded neighbours
+ * (left, up, up-left, up-right) with the previous channel of the pixel and the channel as context, the contexts
+ * merged onto the frequency tables that pay for themselves. The leaf is self-contained: the lags and the phase
+ * period are in each chunk's header, so a decoder needs nothing from the graph program.
+ *
+ * Opt-in: KOLMO_NATIVE=rans (codecs/native.c). Without it no output uses this id. With it every graph leaf and every
+ * sub-stream of the format-2 leaves (21, 23) also tries codec 33 and keeps it only when it is smaller than the
+ * choice of the leaf rule; the frame is then version 11. Decoders before this codec refuse the leaf (unknown codec).
+ * Part of the single translation unit built from src/kolmo.c. */
+#include "../algo/krans.h"
+
+static inline int krans_on(const codec_ctx *x) { return (kolmo_native_flags() & KN_RANS) && !x->no_f2; }
+/* stride = 0: no geometry (orders 0 and 1). effort: 1 at the fast settings, 2 above (more context sets tried). */
+static size_t krans_leaf_compress(const uint8_t *in, size_t n, size_t stride, unsigned step, int effort, uint8_t *out, size_t cap) {
+    kolmo_krans_params p = {0};
+    p.stride = (uint32_t)stride; p.step = (uint8_t)step; p.effort = (uint8_t)effort;
+    return kolmo_krans_compress(in, n, out, cap, &p);
+}
+static int krans_dec_tab(codec_ctx *x, const uint8_t *in, size_t cn, uint8_t *out, size_t n) { return x->allow_f2 ? kolmo_krans_decompress(in, cn, out, n) : -1; }
+static const kolmo_codec codec_krans = { C_KRANS, "krans", NULL, NULL, krans_dec_tab, NULL };   /* written by the graph leaves */
