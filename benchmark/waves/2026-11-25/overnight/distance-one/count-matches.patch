 /* match copy: op is the output position, the match starts off bytes back, ml bytes, the output ends at oe */
+#include <stdio.h>
+static unsigned long long fills, filled_bytes;
+static void __attribute__((destructor)) report_fills(void) {
+    fprintf(stderr, "fills=%llu bytes=%llu\n", fills, filled_bytes);
