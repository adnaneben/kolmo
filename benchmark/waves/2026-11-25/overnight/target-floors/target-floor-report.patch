+static void target_floor_reports(void) {
+    uint8_t input[8192] = {0}, frame[16384], restored[8192];
+    memset(input + 4096, 'a', 4096);
+    const char *table = "kolmo-calibration 1\nspeed binary 1 90000\nbalanced text 2000000 2000000\n";
